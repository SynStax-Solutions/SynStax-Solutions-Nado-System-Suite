@model Nado_Graphics_MS_Frontend.Models.QuoteModel

@{
    ViewData["Title"] = "Quote Details";
    var clientsList = (List<Nado_Graphics_MS_Frontend.Models.ClientModel>)ViewBag.Clients;
    var productsList = (List<Nado_Graphics_MS_Frontend.Models.ProductModel>)ViewBag.Products;

    var client = clientsList.FirstOrDefault(c => c.ClientID == Model.ClientID);
    var clientName = client != null ? $"{client.FirstName} {client.LastName}" : "Unknown Client";
    var products = productsList.ToDictionary(p => p.ProductID, p => p.ProductName);

    var statusColor = Model.QuoteStatus switch
    {
        "Accepted" => "#68926D",
        "Rejected" => "#C85A5A",
        "Expired" => "#B08C3A",
        _ => "#5A93C8"
    };
}

<div style="width: 100%; max-width: 900px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <div>
            <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #24463A;">Quote @Model.ReferenceNumber</h1>
            <span style="
                display: inline-block;
                margin-top: 8px;
                background-color: @statusColor;
                color: white;
                padding: 4px 12px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: 600;">
                @Model.QuoteStatus
            </span>
        </div>
        <a asp-controller="Quotes" asp-action="Index"
               style="background-color: #68926D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background-color: #DCEEDC; color: #24463A; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background-color: #F8D7DA; color: #842029; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">
            @TempData["Error"]
        </div>
    }

    <div style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); padding: 30px; margin-bottom: 20px;">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
            <div>
                <div style="font-weight: 600; color: #24463A; margin-bottom: 4px;">Client</div>
                <div>@clientName</div>
            </div>
            <div>
                <div style="font-weight: 600; color: #24463A; margin-bottom: 4px;">Quote Date</div>
                <div>@Model.QuoteDate.ToString("dd MMM yyyy")</div>
            </div>
            <div>
                <div style="font-weight: 600; color: #24463A; margin-bottom: 4px;">Valid Until</div>
                <div>@(Model.ValidUntil?.ToString("dd MMM yyyy") ?? "-")</div>
            </div>
            <div>
                <div style="font-weight: 600; color: #24463A; margin-bottom: 4px;">Notes</div>
                <div>@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</div>
            </div>
        </div>

        <h3 style="color: #24463A; font-size: 18px; margin-bottom: 12px;">Products</h3>

        <div style="display: grid; grid-template-columns: 2fr 90px 120px 100px 120px; gap: 10px; padding: 10px 0; border-bottom: 2px solid #68926D; font-weight: 700; color: #24463A; font-size: 14px;">
            <div>Product</div>
            <div>Qty</div>
            <div>Unit Price</div>
            <div>VAT</div>
            <div>Line Total</div>
        </div>

        @foreach (var item in Model.QuoteItems)
        {
            var productName = products.TryGetValue(item.ProductID, out var name) ? name : "Unknown Product";

            <div style="display: grid; grid-template-columns: 2fr 90px 120px 100px 120px; gap: 10px; padding: 10px 0; border-bottom: 1px solid #d9d9d9; font-size: 14px;">
                <div>@productName</div>
                <div>@item.Quantity</div>
                <div>R @item.UnitPrice?.ToString("N2")</div>
                <div>@(item.IsVatIncluded ? "Yes" : "No")</div>
                <div>R @item.LineTotal.ToString("N2")</div>
            </div>
        }

        <div style="text-align: right; margin-top: 15px; font-size: 18px; font-weight: 700; color: #24463A;">
            Total: R @Model.TotalAmount.ToString("N2")
        </div>

    </div>

    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px;">

        <a asp-controller="Quotes" asp-action="DownloadPdf" asp-route-id="@Model.QuoteID"
               style="background-color: #5A93C8; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Download PDF
        </a>

        @if (Model.QuoteStatus == "Pending")
        {
            <a asp-controller="Quotes" asp-action="Edit" asp-route-id="@Model.QuoteID"
                   style="background-color: #24463A; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
                Edit
            </a>

            <div class="dropdown">
                <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                        style="
                    background-color: #68926D;
                    color: white;
                    border: none;
                    padding: 10px 20px;
                    border-radius: 7px;
                    font-weight: 600;
                    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.20);">
                    Update Status
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <form asp-controller="Quotes" asp-action="Accept" asp-route-id="@Model.QuoteID" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item">
                                Accept
                            </button>
                        </form>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" id="rejectBtn">
                            Reject
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" id="expireBtn">
                            Mark Expired
                        </button>
                    </li>
                </ul>
            </div>

            <form asp-controller="Quotes" asp-action="Reject" asp-route-id="@Model.QuoteID" method="post" id="rejectForm" style="display: none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reason" id="rejectReason" />
            </form>

            <form asp-controller="Quotes" asp-action="Expire" asp-route-id="@Model.QuoteID" method="post" id="expireForm" style="display: none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reason" id="expireReason" />
            </form>
        }

    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("rejectBtn")?.addEventListener("click", function () {
            const reason = prompt("Reason for rejecting this quote:");
            if (reason === null || reason.trim() === "") return;

            document.getElementById("rejectReason").value = reason.trim();
            document.getElementById("rejectForm").submit();
        });

        document.getElementById("expireBtn")?.addEventListener("click", function () {
            const reason = prompt("Reason for marking this quote as expired:");
            if (reason === null || reason.trim() === "") return;

            document.getElementById("expireReason").value = reason.trim();
            document.getElementById("expireForm").submit();
        });
    </script>
}