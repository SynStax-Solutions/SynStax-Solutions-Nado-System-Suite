
@model Nado_Graphics_MS_Frontend.Models.QuoteModel

@{
    ViewData["Title"] = "Edit Quote";
    var clientsList = (List<Nado_Graphics_MS_Frontend.Models.ClientModel>)ViewBag.Clients;
    var productsList = (List<Nado_Graphics_MS_Frontend.Models.ProductModel>)ViewBag.Products;
}

<style>
    .quote-edit-page {
        width: 100%;
        max-width: 900px;
        color: var(--black, #171717) !important;
    }

    .quote-edit-page .quote-heading {
        color: var(--black, #171717) !important;
    }

    .quote-edit-page .quote-card {
        background: var(--white, #FFFFFF) !important;
        background-color: var(--white, #FFFFFF) !important;
        color: var(--black, #171717) !important;
        border-radius: 14px;
        box-shadow: 0 5px 14px rgba(0,0,0,0.16);
        padding: 30px;
    }

    .quote-edit-page .quote-label {
        display: block;
        font-weight: 600;
        color: var(--black, #171717) !important;
        margin-bottom: 6px;
    }

    .quote-edit-page .quote-input,
    .quote-edit-page .quote-item-row input:not([type="checkbox"]),
    .quote-edit-page .quote-item-row select {
        background: var(--white, #FFFFFF) !important;
        background-color: var(--white, #FFFFFF) !important;
        color: var(--black, #171717) !important;
        border: 1px solid var(--grey, #777777) !important;
        border-radius: 7px;
        padding: 8px 12px;
    }

    .quote-edit-page .quote-input {
        width: 100%;
        min-height: 44px;
    }

    .quote-edit-page .quote-item-row input:not([type="checkbox"]),
    .quote-edit-page .quote-item-row select {
        width: 100%;
        min-width: 0;
        height: 42px;
    }

    .quote-edit-page .quote-input::placeholder,
    .quote-edit-page .quote-item-row input::placeholder {
        color: var(--grey, #777777) !important;
    }

    .quote-edit-page .quote-muted {
        color: var(--grey, #777777) !important;
    }

    .quote-edit-page .quote-error,
    .quote-edit-page .field-validation-error,
    .quote-edit-page .validation-summary-errors {
        color: var(--danger, #B54747) !important;
    }

    .quote-edit-page .quote-mustard {
        display: inline-block;
        background: var(--primary, #D4A72C) !important;
        background-color: var(--primary, #D4A72C) !important;
        color: var(--black, #171717) !important;
        border: none !important;
        border-radius: 7px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
    }

    .quote-edit-page .quote-dark {
        display: inline-block;
        background: var(--dark-grey, #343434) !important;
        background-color: var(--dark-grey, #343434) !important;
        color: var(--white, #FFFFFF) !important;
        border: none !important;
        border-radius: 7px;
        padding: 10px 20px;
        font-weight: 600;
        text-decoration: none !important;
    }

    .quote-edit-page .quote-remove {
        background: var(--danger, #B54747) !important;
        background-color: var(--danger, #B54747) !important;
        color: var(--white, #FFFFFF) !important;
        border: none !important;
        border-radius: 7px;
        height: 42px;
        cursor: pointer;
    }

    .quote-edit-page .quote-item-row {
        display: grid;
        grid-template-columns: 2fr 90px 130px 110px 70px 40px;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
        color: var(--black, #171717) !important;
    }

    .quote-edit-page .item-linetotal,
    .quote-edit-page .quote-item-row label,
    .quote-edit-page .quote-total {
        color: var(--black, #171717) !important;
    }

    .quote-edit-page input[type="checkbox"] {
        accent-color: var(--primary, #D4A72C);
    }

    @@media (max-width: 800px) {
        .quote-edit-page .quote-item-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

<div class="quote-edit-page">

    <!-- PAGE HEADER -->
    <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:15px;
        margin-bottom:25px;">

        <h1 class="quote-heading"
            style="margin:0; font-size:32px; font-weight:700;">
            Edit Quote @Model.ReferenceNumber
        </h1>

        <a asp-controller="Quotes"
           asp-action="Details"
           asp-route-id="@Model.QuoteID"
           class="quote-dark">
            Back
        </a>

    </div>

    <!-- EDIT QUOTE CARD -->
    <div class="quote-card">

        <form asp-controller="Quotes"
              asp-action="Edit"
              method="post"
              id="quoteForm">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="QuoteID" />
            <input type="hidden" asp-for="ReferenceNumber" />

            <!-- VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly"
                 class="quote-error"
                 style="margin-bottom:15px;">
            </div>

            <!-- CLIENT -->
            <div style="margin-bottom:18px;">

                <label class="quote-label">
                    Client
                </label>

                <select asp-for="ClientID" class="quote-input">

                    <option value="">Select a client...</option>

                    @foreach (var client in clientsList)
                    {
                        <option value="@client.ClientID">
                            @client.FirstName @client.LastName
                        </option>
                    }

                </select>

                <span asp-validation-for="ClientID"
                      class="quote-error"
                      style="font-size:13px;">
                </span>

            </div>

            <!-- VALID UNTIL -->
            <div style="margin-bottom:18px;">

                <label class="quote-label">
                    Valid Until
                </label>

                <input asp-for="ValidUntil"
                       type="date"
                       class="quote-input" />

            </div>

            <!-- NOTES -->
            <div style="margin-bottom:25px;">

                <label class="quote-label">
                    Notes
                </label>

                <textarea asp-for="Notes"
                          rows="3"
                          class="quote-input"
                          style="resize:vertical;"></textarea>

            </div>

            <!-- PRODUCTS -->
            <h3 class="quote-heading"
                style="font-size:18px; margin-bottom:12px;">
                Products
            </h3>

            <div id="itemsContainer"
                 style="margin-bottom:12px; overflow-x:auto;">
            </div>

            <!-- ADD PRODUCT -->
            <button type="button"
                    id="addItemBtn"
                    class="quote-mustard"
                    style="margin-bottom:20px;">
                + Add Product
            </button>

            <!-- TOTAL -->
            <div style="text-align:right; margin-bottom:25px;">

                <div class="quote-muted"
                     style="font-size:13px; margin-bottom:4px;">
                    Includes VAT: R<span id="vatAmount">0.00</span>
                </div>

                <div class="quote-total"
                     style="font-size:18px; font-weight:700;">
                    Estimated Total: R<span id="grandTotal">0.00</span>
                </div>

            </div>

            <!-- ACTION BUTTONS -->
            <div style="
                display:flex;
                gap:12px;
                justify-content:flex-end;">

                <a asp-controller="Quotes"
                   asp-action="Details"
                   asp-route-id="@Model.QuoteID"
                   class="quote-dark"
                   style="padding:10px 24px;">
                    Cancel
                </a>

                <button type="submit"
                        class="quote-mustard"
                        style="padding:10px 24px;">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

    <!-- DYNAMIC PRODUCT ROW TEMPLATE -->
    <template id="itemRowTemplate">

        <div class="quote-item-row">

            <!-- PRODUCT -->
            <select name="QuoteItems[__INDEX__].ProductID"
                    class="item-product"
                    required>

                <option value="">Select a product...</option>

                @foreach (var product in productsList)
                {
                    <option value="@product.ProductID"
                            data-price="@product.Price">
                        @product.ProductName (R @product.Price)
                    </option>
                }

            </select>

            <!-- QUANTITY -->
            <input type="number"
                   name="QuoteItems[__INDEX__].Quantity"
                   class="item-quantity"
                   min="1"
                   value="1"
                   required />

            <!-- UNIT PRICE -->
            <input type="number"
                   step="0.01"
                   name="QuoteItems[__INDEX__].UnitPrice"
                   class="item-unitprice"
                   min="0"
                   placeholder="Default price" />

            <!-- LINE TOTAL -->
            <span class="item-linetotal"
                  style="font-weight:600;">
                R0.00
            </span>

            <!-- VAT -->
            <label style="
                display:flex;
                align-items:center;
                gap:5px;
                font-size:13px;">

                <input type="checkbox"
                       name="QuoteItems[__INDEX__].IsVatIncluded"
                       class="item-vat"
                       value="true" />

                VAT

            </label>

            <!-- REMOVE -->
            <button type="button"
                    class="remove-item-btn quote-remove">
                X
            </button>

        </div>

    </template>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const itemsContainer = document.getElementById("itemsContainer");
        const template = document.getElementById("itemRowTemplate").innerHTML;
        let rowIndex = 0;

        // The quote's existing items, passed from the server so the form starts pre-filled.
        const existingItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuoteItems));

        function calculateLineTotal(row) {
            const select = row.querySelector(".item-product");
            const quantityInput = row.querySelector(".item-quantity");
            const unitPriceInput = row.querySelector(".item-unitprice");
            const lineTotalSpan = row.querySelector(".item-linetotal");

            const selectedOption = select.options[select.selectedIndex];
            const defaultPrice = selectedOption ? parseFloat(selectedOption.dataset.price || 0) : 0;
            const unitPrice = unitPriceInput.value ? parseFloat(unitPriceInput.value) : defaultPrice;
            const quantity = parseFloat(quantityInput.value) || 0;

            const lineTotal = quantity * unitPrice;
            lineTotalSpan.textContent = "R" + lineTotal.toFixed(2);

            updateGrandTotal();
        }

        function updateGrandTotal() {
            let total = 0;
            let vatTotal = 0;
            const vatRate = 0.15;

            document.querySelectorAll(".quote-item-row").forEach(function (row) {
                const lineTotalText = row.querySelector(".item-linetotal").textContent.replace("R", "");
                const lineTotal = parseFloat(lineTotalText) || 0;
                const isVatIncluded = row.querySelector(".item-vat").checked;

                total += lineTotal;

                if (isVatIncluded) {
                    vatTotal += lineTotal * vatRate / (1 + vatRate);
                }
            });

            document.getElementById("grandTotal").textContent = total.toFixed(2);
            document.getElementById("vatAmount").textContent = vatTotal.toFixed(2);
        }

        function reindexRows() {
            const rows = itemsContainer.querySelectorAll(".quote-item-row");

            rows.forEach(function (row, i) {
                row.querySelectorAll("[name]").forEach(function (field) {
                    field.name = field.name.replace(/\[\d+\]/, "[" + i + "]");
                });
            });

            rowIndex = rows.length;
        }

        // existingItem is null for a fresh blank row, or the item data to pre-fill.
        function addRow(existingItem) {
            const html = template.replaceAll("__INDEX__", rowIndex);
            const wrapper = document.createElement("div");
            wrapper.innerHTML = html.trim();

            const row = wrapper.firstElementChild;

            itemsContainer.appendChild(row);
            rowIndex++;

            if (existingItem) {
                row.querySelector(".item-product").value = existingItem.productID;
                row.querySelector(".item-quantity").value = existingItem.quantity;
                row.querySelector(".item-unitprice").value = existingItem.unitPrice;
                row.querySelector(".item-vat").checked = existingItem.isVatIncluded;
            }

            calculateLineTotal(row);

            row.querySelector(".item-product").addEventListener("change", function () {
                calculateLineTotal(row);
            });

            row.querySelector(".item-quantity").addEventListener("input", function () {
                calculateLineTotal(row);
            });

            row.querySelector(".item-unitprice").addEventListener("input", function () {
                calculateLineTotal(row);
            });

            row.querySelector(".item-vat").addEventListener("change", updateGrandTotal);

            row.querySelector(".remove-item-btn").addEventListener("click", function () {
                row.remove();
                reindexRows();
                updateGrandTotal();
            });
        }

        document.getElementById("addItemBtn").addEventListener("click", function () {
            addRow(null);
        });

        // Pre-fill with the quote's existing items, or one blank row if it somehow has none.
        if (existingItems && existingItems.length > 0) {
            existingItems.forEach(function (item) {
                addRow(item);
            });
        } else {
            addRow(null);
        }
    </script>
}

