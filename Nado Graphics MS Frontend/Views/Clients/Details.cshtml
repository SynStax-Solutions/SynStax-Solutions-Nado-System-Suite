@model Nado_Graphics_MS_Frontend.Models.ClientModel

@{
ViewData["Title"] = "Client Details";
}

<div style="width: 100%;">

<div style="
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 25px; ">

    <div>

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: #24463A; ">
            Client Details
        </h1>

        <p style="
            margin: 5px 0 0 0;
            color: #555;
            font-size: 15px; ">
            View the details of @Model.FirstName @Model.LastName.
        </p>

    </div>

    <a asp-action="Index"
       style="
            background-color: #68926D;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 7px;
            font-weight: 600; ">
        Back to Clients
    </a>

</div>

<div style="
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px; ">

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.20);
        padding: 25px; ">

        <h2 style="
            margin: 0;
            color: #24463A;
            font-size: 21px;
            font-weight: 700;
            padding-bottom: 10px;
            border-bottom: 2px solid #68926D; ">
            Personal Information
        </h2>

        <div style="margin-top: 20px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                First Name
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @Model.FirstName
            </div>

        </div>

        <div style="margin-top: 18px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                Surname
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @Model.LastName
            </div>

        </div>

        <div style="margin-top: 18px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                Client Type
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @Model.ClientType
            </div>

        </div>

    </div>

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.20);
        padding: 25px; ">

        <h2 style="
            margin: 0;
            color: #24463A;
            font-size: 21px;
            font-weight: 700;
            padding-bottom: 10px;
            border-bottom: 2px solid #68926D; ">
            Contact Information
        </h2>

        <div style="
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px; ">
            <div>

                <div style="
                    font-weight: 600;
                    margin-bottom: 6px; ">
                    Email Address
                </div>

                <div style="
                    border: 2px solid #aaa;
                    border-radius: 7px;
                    padding: 10px;
                    background-color: #f8f8f8;
                    word-break: break-word; ">
                    @Model.Email
                </div>

            </div>

            <div>

                <div style="
                    font-weight: 600;
                    margin-bottom: 6px; ">
                    Phone Number
                </div>

                <div style="
                    border: 2px solid #aaa;
                    border-radius: 7px;
                    padding: 10px;
                    background-color: #f8f8f8; ">
                    @Model.PhoneNumber
                </div>

            </div>

        </div>

        <div style="margin-top: 18px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                Alternative Number
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @(string.IsNullOrWhiteSpace(Model.AlternativeNumber) ? "Not provided" : Model.AlternativeNumber)
            </div>

        </div>

    </div>

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.20);
        padding: 25px; ">

        <h2 style="
            margin: 0;
            color: #24463A;
            font-size: 21px;
            font-weight: 700;
            padding-bottom: 10px;
            border-bottom: 2px solid #68926D; ">
            Address
        </h2>

        <div style="margin-top: 20px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                Street Address
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @(string.IsNullOrWhiteSpace(Model.StreetAddress) ? "Not provided" : Model.StreetAddress)
            </div>

        </div>

        <div style="
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 18px; ">
            <div>

                <div style="
                    font-weight: 600;
                    margin-bottom: 6px; ">
                    City
                </div>

                <div style="
                    border: 2px solid #aaa;
                    border-radius: 7px;
                    padding: 10px;
                    background-color: #f8f8f8; ">
                    @(string.IsNullOrWhiteSpace(Model.City) ? "Not provided" : Model.City)
                </div>

            </div>

            <div>

                <div style="
                    font-weight: 600;
                    margin-bottom: 6px; ">
                    Postal Code
                </div>

                <div style="
                    border: 2px solid #aaa;
                    border-radius: 7px;
                    padding: 10px;
                    background-color: #f8f8f8; ">
                    @(string.IsNullOrWhiteSpace(Model.PostalCode) ? "Not provided" : Model.PostalCode)
                </div>

            </div>

        </div>

    </div>

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.20);
        padding: 25px; ">

        <h2 style="
            margin: 0;
            color: #24463A;
            font-size: 21px;
            font-weight: 700;
            padding-bottom: 10px;
            border-bottom: 2px solid #68926D; ">
            Organisation
        </h2>

        <div style="margin-top: 20px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                Organisation
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @(string.IsNullOrWhiteSpace(Model.OrganisationName) ? "No Organisation" : Model.OrganisationName)
            </div>

        </div>

        <div style="margin-top: 18px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px;">
                Organisation ID
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @(Model.OrganisationID.HasValue ? Model.OrganisationID.ToString() : "Not assigned")
            </div>

        </div>

        <div style="margin-top: 18px;">

            <div style="
                font-weight: 600;
                margin-bottom: 6px; ">
                Client ID
            </div>

            <div style="
                border: 2px solid #aaa;
                border-radius: 7px;
                padding: 10px;
                background-color: #f8f8f8; ">
                @Model.ClientID
            </div>

        </div>

    </div>

</div>

<div style="
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 25px;
    margin-bottom: 20px; ">

    <a asp-action="Index"
       style="
            background-color: #68926D;
            color: white;
            text-decoration: none;
            padding: 11px 22px;
            border-radius: 7px;
            font-weight: 600; ">
        <i class="bi bi-arrow-left"></i>
        Back to Clients
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model.ClientID"
       style="
            background-color: #5A93C8;
            color: white;
            text-decoration: none;
            padding: 11px 22px;
            border-radius: 7px;
            font-weight: 600; ">
        <i class="bi bi-pencil"></i>
        Edit Client
    </a>

</div>


</div>
