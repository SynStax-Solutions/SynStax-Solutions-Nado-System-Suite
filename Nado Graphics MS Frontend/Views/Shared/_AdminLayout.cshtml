
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Nado Graphics
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Existing site styling -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Shared component styling -->
    <link rel="stylesheet"
          href="~/css/shared.css"
          asp-append-version="true" />

    <!-- Admin layout styling (kept independent from shared.css) -->
    <style>
        .admin-layout {
            display: flex;
            min-height: 100vh;
            background-color: #F5F5F5;
        }

        .admin-sidebar {
            width: 240px;
            min-width: 240px;
            min-height: 100vh;
            background-color: #171717;
            padding: 25px 15px;
            box-sizing: border-box;
            border-right: 3px solid #D4A72C;
        }

        .admin-sidebar .admin-logo {
            display: block;
            margin-bottom: 8px;
        }

        .admin-sidebar .admin-logo img {
            display: block;
            height: 40px;
            width: auto;
            max-width: 100%;
            object-fit: contain;
        }

        .admin-sidebar .admin-sidebar-label {
            color: #D4A72C;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0 0 30px 4px;
        }

        .admin-sidebar .admin-nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .admin-sidebar .admin-nav-link {
            display: block;
            width: 100%;
            padding: 12px 15px;
            color: #FFFFFF;
            text-decoration: none;
            border-radius: 7px;
            font-size: 15px;
            font-weight: 600;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .admin-sidebar .admin-nav-link:hover {
            background-color: #D4A72C;
            color: #171717;
            text-decoration: none;
        }

        .admin-sidebar .admin-sidebar-footer {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #777777;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .admin-sidebar .admin-logout {
            background: none;
            border: none;
            text-align: left;
            cursor: pointer;
            font-family: inherit;
        }

        .admin-sidebar .admin-logout:hover {
            background-color: #D4A72C;
            color: #171717;
        }

        .admin-main {
            flex: 1;
            min-width: 0;
        }
    </style>

</head>

<body>

    <div class="admin-layout">

        <!-- SIDE NAVIGATION -->

        <div class="admin-sidebar">

            <a asp-controller="Admins"
               asp-action="Dashboard"
               class="admin-logo">

                <img src="~/images/nadoms-logo-white.png"
                     alt="NadoMS" />

            </a>

            <div class="admin-sidebar-label">
                PA/Admin
            </div>

            <div class="admin-nav">

                <a asp-controller="Admins"
                   asp-action="Dashboard"
                   class="admin-nav-link">
                    Dashboard
                </a>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="admin-nav-link">
                    Users
                </a>

                <a asp-controller="JobCards"
                   asp-action="Index"
                   class="admin-nav-link">
                    Job Cards
                </a>

                <a asp-controller="Quotes"
                   asp-action="Index"
                   class="admin-nav-link">
                    Quotes
                </a>

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="admin-nav-link">
                    Invoices
                </a>

                <a asp-controller="Statements"
                   asp-action="Index"
                   class="admin-nav-link">
                    Statements
                </a>

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="admin-nav-link">
                    Payment Records
                </a>

                <a asp-controller="Clients"
                   asp-action="Index"
                   class="admin-nav-link">
                    Clients
                </a>

                <a asp-controller="Suppliers"
                   asp-action="Index"
                   class="admin-nav-link">
                    Suppliers
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="admin-nav-link">
                    Product Catalogue
                </a>

                <a asp-controller="Portfolio"
                   asp-action="Index"
                   class="admin-nav-link">
                    Portfolio
                </a>

            </div>

            <div class="admin-sidebar-footer">

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="admin-nav-link">
                    Change Password
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="admin-nav-link admin-logout">
                        Log Out
                    </button>

                </form>

            </div>

        </div>

        <!-- PAGE CONTENT -->

        <div class="admin-main">

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
