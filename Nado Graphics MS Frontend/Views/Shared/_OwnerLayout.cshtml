
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Nado Graphics
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        body {
            margin: 0;
            background-color: #F5F5F5;
            color: #171717;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .owner-layout {
            display: flex;
            min-height: 100vh;
            background-color: #F5F5F5;
        }

        .owner-sidebar {
            width: 240px;
            min-width: 240px;
            min-height: 100vh;
            background-color: #171717;
            padding: 25px 15px;
            box-sizing: border-box;
            border-right: 3px solid #D4A72C;
        }

        .owner-logo {
            display: block;
            margin-bottom: 8px;
        }

        .owner-logo img {
            display: block;
            height: 40px;
            width: auto;
            max-width: 100%;
            object-fit: contain;
        }

        .owner-sidebar-label {
            color: #D4A72C;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin: 0 0 30px 4px;
        }

        .owner-navigation {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .owner-nav-link {
            display: block;
            padding: 12px 15px;
            color: #FFFFFF;
            text-decoration: none;
            border-radius: 7px;
            font-size: 15px;
            font-weight: 600;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .owner-nav-link:hover,
        .owner-nav-link.active {
            background-color: #D4A72C;
            color: #171717;
            text-decoration: none;
        }

        .owner-bottom-links {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #777777;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .owner-logout-form {
            margin: 0;
        }

        .owner-logout-button {
            display: block;
            width: 100%;
            padding: 12px 15px;
            color: #FFFFFF;
            background: none;
            border: none;
            text-align: left;
            text-decoration: none;
            border-radius: 7px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .owner-logout-button:hover {
            background-color: #D4A72C;
            color: #171717;
        }

        .owner-main {
            flex: 1;
            min-width: 0;
        }
    </style>

</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="owner-layout">

        <!-- SIDE NAVIGATION -->

        <div class="owner-sidebar">

            <a asp-controller="Owner"
               asp-action="Dashboard"
               class="owner-logo">

                <img src="~/images/nadoms-logo-white.png"
                     alt="NadoMS" />

            </a>

            <div class="owner-sidebar-label">
                Owner
            </div>

            <!-- MAIN NAVIGATION -->

            <div class="owner-navigation">

                <a asp-controller="Owner"
                   asp-action="Dashboard"
                   class="owner-nav-link @(currentController == "Owner" ? "active" : "")">
                    Dashboard
                </a>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Users" ? "active" : "")">
                    Users
                </a>

                <a asp-controller="JobCards"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "JobCards" ? "active" : "")">
                    Job Cards
                </a>

                <a asp-controller="Quotes"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Quotes" ? "active" : "")">
                    Quotes
                </a>

                <a asp-controller="Invoices"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Invoices" ? "active" : "")">
                    Invoices
                </a>

                <a asp-controller="Statements"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Statements" ? "active" : "")">
                    Statements
                </a>

                <a asp-controller="Payments"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Payments" ? "active" : "")">
                    Payment Records
                </a>

                <a asp-controller="Clients"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Clients" ? "active" : "")">
                    Clients
                </a>

                <!-- ORGANISATIONS -->

                <a asp-controller="Organisations"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Organisations" ? "active" : "")">
                    Organisations
                </a>

                <a asp-controller="Suppliers"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Suppliers" ? "active" : "")">
                    Suppliers
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Products" ? "active" : "")">
                    Product Catalogue
                </a>

                <a asp-controller="Portfolio"
                   asp-action="Index"
                   class="owner-nav-link @(currentController == "Portfolio" ? "active" : "")">
                    Portfolio
                </a>

            </div>

            <!-- BOTTOM LINKS -->

            <div class="owner-bottom-links">

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="owner-nav-link @(currentController == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword" ? "active" : "")">
                    Change Password
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="owner-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="owner-logout-button">
                        Log Out
                    </button>

                </form>

            </div>

        </div>

        <!-- PAGE CONTENT -->

        <div class="owner-main">

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
