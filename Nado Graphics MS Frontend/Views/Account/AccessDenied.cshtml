@* This page shows when a user tries to open a page their role isn't allowed to see. *@
@{
    ViewData["Title"] = "Access Denied";

    //This works out which dashboard to send the user back to.
    var (action, controller) = AppRoles.DashboardFor(User.FindFirst(ClaimTypes.Role)?.Value);
}

<div class="status-container">
    <h1 class="status-title status-title-danger">Access Denied</h1>
    <p class="status-description">Your role does not have permission to open this page.</p>
    <a asp-controller="@controller" asp-action="@action" class="btn btn-primary">
        Back to my dashboard
    </a>
</div>