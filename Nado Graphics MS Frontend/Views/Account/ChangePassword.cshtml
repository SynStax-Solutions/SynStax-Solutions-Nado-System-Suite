@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

@* This page lets any logged-in user change their own password. *@
<div class="account-container">
    <div class="account-card">

        <div class="account-header">
            <h4>Change Password</h4>
        </div>

        <div class="account-body">

            <form asp-action="ChangePassword" method="post">

                @* This shows errors like "Your current password is incorrect". *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <small class="text-muted">8 to 64 characters.</small>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="account-actions">

                    <button type="submit" class="btn btn-primary">
                        Change Password
                    </button>

                    @* Cancel goes back to the home page, which sends the user to their dashboard. *@
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

            <p class="account-footer mb-0">
                After changing your password you'll be logged out and asked to log in again.
                You'll also be logged out on any other devices.
            </p>

        </div>
    </div>
</div>

@* This turns on the form checks in the browser (e.g. passwords don't match). *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}