@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

@* This page lets any logged-in user change their own password. *@
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">

        <div style="background-color: white; border: 2px solid black; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);">

            <div style="background-color: #68926D; color: white; padding: 18px 25px;">
                <h4 style="margin: 0; font-weight: 600;">Change Password</h4>
            </div>

            <div style="padding: 25px;">

                <form asp-action="ChangePassword" method="post">

                    @* This shows errors like "Your current password is incorrect". *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label" style="font-weight: 600; color: #24463A;">Current Password</label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label" style="font-weight: 600; color: #24463A;">New Password</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <small class="text-muted">8 to 64 characters.</small>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label" style="font-weight: 600; color: #24463A;">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">

                        <button type="submit" class="btn"
                                style="background-color: #68926D; color: white; border: none; padding: 10px 20px; border-radius: 7px;">
                            Change Password
                        </button>

                        @* Cancel goes back to the home page, which sends the user to their dashboard. *@
                        <a asp-controller="Home" asp-action="Index" class="btn"
                           style="background-color: #D46271; color: white; border: none; padding: 10px 20px; border-radius: 7px;">
                            Cancel
                        </a>

                    </div>

                </form>

                <p class="text-muted mt-3 mb-0" style="font-size: 14px;">
                    After changing your password you'll be logged out and asked to log in again.
                    You'll also be logged out on any other devices.
                </p>

            </div>
        </div>

    </div>
</div>

@* This turns on the form checks in the browser (e.g. passwords don't match). *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}