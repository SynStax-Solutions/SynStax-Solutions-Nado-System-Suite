@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

@* This is the login page. There is no sign-up link because only the Owner or Admin can create accounts. *@
<div class="account-container">
    <div class="account-card">

        <div class="account-header">
            <h4>Nado Graphics - Log In</h4>
        </div>

        <div class="account-body">

            @* This shows a green message, e.g. after changing your password. *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <form asp-action="Login" method="post">

                @* This remembers which page the user was trying to open. *@
                <input asp-for="ReturnUrl" type="hidden" />

                @* This shows errors like "Invalid email or password". *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-mustard w-100">
                    Log In
                </button>
            </form>

            @* This link lets users who forgot their password get a reset email. *@
            <div class="text-center mt-3">
                <a asp-action="ForgotPassword" class="account-link">Forgot your password?</a>
            </div>

            <p class="account-footer">
                Accounts are created by the business owner or an administrator.
                If you don't have an account, please ask them to create one for you.
            </p>
        </div>
    </div>
</div>

@* This turns on the form checks in the browser (e.g. empty fields). *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
