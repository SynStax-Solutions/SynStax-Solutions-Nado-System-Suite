@model LoginViewModel

@{
    ViewData["Title"] = "Log In";
}

@* This is the login page. There is no sign-up link because only the Owner or Admin can create accounts. *@
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">

        <div style="background-color: white; border: 2px solid black; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);">

            <div style="background-color: #68926D; color: white; padding: 18px 25px;">
                <h4 style="margin: 0; font-weight: 600;">Nado Graphics - Log In</h4>
            </div>

            <div style="padding: 25px;">

                @* This shows a green message, e.g. after changing your password. *@
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <form asp-action="Login" method="post">

                    @* This remembers which page the user was trying to open. *@
                    <input asp-for="ReturnUrl" type="hidden" />

                    @* This shows errors like "Invalid email or password". *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="font-weight: 600; color: #24463A;">Email Address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label" style="font-weight: 600; color: #24463A;">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn w-100"
                            style="background-color: #68926D; color: white; border: none; padding: 10px 20px; border-radius: 7px;">
                        Log In
                    </button>

                </form>

                <p class="text-muted mt-3 mb-0" style="font-size: 14px;">
                    Accounts are created by the business owner or an administrator.
                    If you don't have an account, please ask them to create one for you.
                </p>

            </div>
        </div>

    </div>
</div>

@* This turns on the form checks in the browser (e.g. empty fields). *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}