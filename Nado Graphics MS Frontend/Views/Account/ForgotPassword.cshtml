@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

@* This page lets a user ask for a password reset link by email. *@
<div class="account-container">
    <div class="account-card">

        <div class="account-header">
            <h4>Forgot Password</h4>
        </div>

        <div class="account-body">

            <p class="account-description">
                Enter the email address you log in with. If it has an account, we'll email you a link to reset your password.
            </p>

            <form asp-action="ForgotPassword" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="account-actions">
                    <button type="submit" class="btn btn-primary">
                        Send Reset Link
                    </button>

                    <a asp-action="Login" class="btn btn-secondary">
                        Back to Log In
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@* This turns on the form checks in the browser. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}