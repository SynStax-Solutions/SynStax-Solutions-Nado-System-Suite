@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

@* This page lets a user ask for a password reset link by email. *@
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div style="background-color: white; border: 2px solid black; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);">

            <div style="background-color: #68926D; color: white; padding: 18px 25px;">
                <h4 style="margin: 0; font-weight: 600;">Forgot Password</h4>
            </div>

            <div style="padding: 25px;">

                <p style="font-size: 14px;">
                    Enter the email address you log in with. If it has an account, we'll email you a link to reset your password.
                </p>

                <form asp-action="ForgotPassword" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label" style="font-weight: 600; color: #24463A;">Email Address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <button type="submit" class="btn" style="background-color: #68926D; color: white; border: none; padding: 10px 20px; border-radius: 7px;">
                            Send Reset Link
                        </button>
                        <a asp-action="Login" class="btn" style="background-color: #D46271; color: white; border: none; padding: 10px 20px; border-radius: 7px;">
                            Back to Log In
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* This turns on the form checks in the browser. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}