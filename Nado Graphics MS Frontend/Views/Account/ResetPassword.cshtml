@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

@* This page opens from the link in the reset email and lets the user choose a new password. *@
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div style="background-color: white; border: 2px solid black; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);">

            <div style="background-color: #68926D; color: white; padding: 18px 25px;">
                <h4 style="margin: 0; font-weight: 600;">Reset Password</h4>
            </div>

            <div style="padding: 25px;">

                @if (string.IsNullOrWhiteSpace(Model.Token))
                {
                    @* This shows if the page was opened without a token in the link. *@
                    <div class="alert alert-danger">This password reset link is invalid. Please request a new one.</div>
                    <a asp-action="ForgotPassword" class="btn" style="background-color: #68926D; color: white; border: none; padding: 10px 20px; border-radius: 7px;">Request a new link</a>
                }
                else
                {
                    <form asp-action="ResetPassword" method="post">

                        @* The token from the email link is sent back with the form. *@
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label" style="font-weight: 600; color: #24463A;">New Password</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                            <small class="text-muted">8 to 64 characters.</small>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label" style="font-weight: 600; color: #24463A;">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn w-100" style="background-color: #68926D; color: white; border: none; padding: 10px 20px; border-radius: 7px;">
                            Reset Password
                        </button>
                    </form>

                    <p class="text-muted mt-3 mb-0" style="font-size: 14px;">
                        After resetting, you'll be logged out on all devices and can log in with your new password.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@* This turns on the form checks in the browser. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}