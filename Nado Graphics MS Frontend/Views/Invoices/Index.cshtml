@model List<Nado_Graphics_MS_Frontend.Models.InvoiceModel>

@{
    ViewData["Title"] = "Invoices";
    var clients = ((List<Nado_Graphics_MS_Frontend.Models.ClientModel>)ViewBag.Clients)
        .ToDictionary(c => c.ClientID, c => $"{c.FirstName} {c.LastName}");
}

<div style="width: 100%;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #24463A;">Invoices</h1>
        <a asp-controller="Owner" asp-action="Dashboard"
               style="background-color: #68926D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>
    </div>

    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 25px;">
        <div style="flex: 1;">
            <input type="text" id="invoiceSearch" placeholder="Search by reference number or client..."
                   style="width: 100%; height: 44px; padding: 8px 15px; border: 1px solid #aaa; border-radius: 7px; font-size: 15px; outline: none;" />
        </div>
        <div style="min-width: 200px;">
            <select id="statusFilter" style="width: 100%; height: 44px; padding: 8px 12px; border: 1px solid #aaa; border-radius: 7px; background-color: white; font-size: 15px;">
                <option value="">All Statuses</option>
                <option value="Unpaid">Unpaid</option>
                <option value="Partially Paid">Partially Paid</option>
                <option value="Paid">Paid</option>
                <option value="Overdue">Overdue</option>
                <option value="Extension Requested">Extension Requested</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
        <a asp-controller="Invoices" asp-action="Create"
               style="height: 44px; display: flex; align-items: center; gap: 7px; background-color: #5A93C8; color: white; text-decoration: none; padding: 0 20px; border-radius: 7px; font-weight: 600; white-space: nowrap;">
            Create Invoice
        </a>
    </div>

    <div style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); overflow: hidden;">

        <div style="display: grid; grid-template-columns: 90px 1.1fr 1.2fr 1fr 1fr 1.3fr 140px; align-items: center; padding: 16px 20px; background-color: #68926D; color: white; font-weight: 700; font-size: 14px;">
            <div>Invoice ID</div>
            <div>Reference</div>
            <div>Client</div>
            <div>Total</div>
            <div>Paid</div>
            <div>Status</div>
            <div style="text-align: center;">Manage</div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div style="padding: 55px 20px; text-align: center; color: #666;">
                <h3 style="margin-top: 12px; color: #24463A;">No Invoices Found</h3>
                <p style="margin-bottom: 0;">There are currently no invoices on record.</p>
            </div>
        }
        else
        {
            foreach (var invoice in Model)
            {
                var clientName = clients.TryGetValue(invoice.ClientID, out var name) ? name : "Unknown Client";

                var statusColor = invoice.InvoiceStatus switch
                {
                    "Paid" => "#68926D",
                    "Partially Paid" => "#5A93C8",
                    "Overdue" => "#C85A5A",
                    "Extension Requested" => "#B08C3A",
                    "Cancelled" => "#999999",
                    _ => "#DFA738"
                };

                <div class="invoice-row"
                     data-reference="@invoice.ReferenceNumber"
                     data-client="@clientName"
                     data-status="@invoice.InvoiceStatus"
                     style="display: grid; grid-template-columns: 90px 1.1fr 1.2fr 1fr 1fr 1.3fr 140px; align-items: center; padding: 16px 20px; border-bottom: 1px solid #d9d9d9; font-size: 14px;">

                    <div>@invoice.InvoiceID</div>
                    <div style="font-weight: 600; color: #24463A;">@invoice.ReferenceNumber</div>
                    <div>@clientName</div>
                    <div>R @invoice.TotalAmount.ToString("N2")</div>
                    <div>R @invoice.AmountPaid.ToString("N2")</div>
                    <div>
                        <span style="background-color: @statusColor; color: white; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                            @invoice.InvoiceStatus
                        </span>
                    </div>

                    <div style="display: flex; justify-content: center; align-items: center;">
                        <div class="dropdown">
                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    style="background-color: #68926D; color: white; border: none; border-radius: 7px; box-shadow: 0 3px 6px rgba(0, 0, 0, 0.20);">
                                Manage
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Invoices" asp-action="DownloadPdf" asp-route-id="@invoice.InvoiceID">
                                        Download PDF
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice.InvoiceID">
                                        View
                                    </a>
                                </li>
                                @if (invoice.InvoiceStatus != "Paid" && invoice.InvoiceStatus != "Cancelled")
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Invoices" asp-action="Edit" asp-route-id="@invoice.InvoiceID">
                                            Edit
                                        </a>
                                    </li>
                                }
                                <li>
                                    <form asp-controller="Invoices" asp-action="Delete" asp-route-id="@invoice.InvoiceID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item"
                                                onclick="return confirm('Are you sure you want to delete this invoice?');">
                                            Delete
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            }
        }

    </div>

</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("invoiceSearch");
        const statusFilter = document.getElementById("statusFilter");
        const invoiceRows = document.querySelectorAll(".invoice-row");

        function filterInvoices() {
            const searchValue = searchInput.value.toLowerCase().trim();
            const statusValue = statusFilter.value;

            invoiceRows.forEach(function (row) {
                const reference = row.dataset.reference.toLowerCase();
                const client = row.dataset.client.toLowerCase();
                const status = row.dataset.status;

                const matchesSearch = reference.includes(searchValue) || client.includes(searchValue);
                const matchesStatus = statusValue === "" || status === statusValue;

                row.style.display = (matchesSearch && matchesStatus) ? "grid" : "none";
            });
        }

        searchInput.addEventListener("input", filterInvoices);
        statusFilter.addEventListener("change", filterInvoices);
    </script>
}