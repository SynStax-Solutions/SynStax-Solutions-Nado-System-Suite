@model Nado_Graphics_MS_Frontend.Models.InvoiceModel

@{
    ViewData["Title"] = "Edit Invoice";
    var clientsList = (List<Nado_Graphics_MS_Frontend.Models.ClientModel>)ViewBag.Clients;
    var productsList = (List<Nado_Graphics_MS_Frontend.Models.ProductModel>)ViewBag.Products;
}

<div style="width: 100%; max-width: 900px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">

        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: var(--black, #171717) !important;">
            Edit Invoice @Model.ReferenceNumber
        </h1>

        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceID"
           style="background-color: var(--dark-grey, #343434) !important; color: var(--white, #FFFFFF) !important; text-decoration: none !important; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>

    </div>

    <div style="background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); padding: 30px;">

        <form asp-controller="Invoices" asp-action="Edit" method="post" id="invoiceForm">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="InvoiceID" />
            <input type="hidden" asp-for="ReferenceNumber" />
            <input type="hidden" asp-for="InvoiceStatus" />
            <input type="hidden" asp-for="AmountPaid" />

            <div asp-validation-summary="ModelOnly"
                 style="color: var(--danger, #B54747) !important; margin-bottom: 15px;">
            </div>

            <div style="margin-bottom: 18px;">

                <label style="display: block; font-weight: 600; color: var(--black, #171717) !important; margin-bottom: 6px;">
                    Client
                </label>

                <select asp-for="ClientID"
                        style="width: 100%; height: 44px; padding: 8px 12px; border: 1px solid var(--grey, #777777) !important; border-radius: 7px; background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important;">

                    <option value="">Select a client...</option>

                    @foreach (var client in clientsList)
                    {
                        <option value="@client.ClientID">@client.FirstName @client.LastName</option>
                    }

                </select>

                <span asp-validation-for="ClientID"
                      style="color: var(--danger, #B54747) !important; font-size: 13px;">
                </span>

            </div>

            <div style="margin-bottom: 18px;">

                <label style="display: block; font-weight: 600; color: var(--black, #171717) !important; margin-bottom: 6px;">
                    Due Date
                </label>

                <input asp-for="DueDate" type="date"
                       style="width: 100%; height: 44px; padding: 8px 12px; border: 1px solid var(--grey, #777777) !important; border-radius: 7px; background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important;" />

            </div>

            <div style="margin-bottom: 25px;">

                <label style="display: block; font-weight: 600; color: var(--black, #171717) !important; margin-bottom: 6px;">
                    Notes
                </label>

                <textarea asp-for="Notes" rows="3"
                          style="width: 100%; padding: 10px 12px; border: 1px solid var(--grey, #777777) !important; border-radius: 7px; resize: vertical; background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important;"></textarea>

            </div>

            <h3 style="color: var(--black, #171717) !important; font-size: 18px; margin-bottom: 12px;">
                Products
            </h3>

            <div id="itemsContainer" style="margin-bottom: 12px;"></div>

            <button type="button" id="addItemBtn"
                    style="background-color: var(--primary, #D4A72C) !important; color: var(--black, #171717) !important; border: none !important; padding: 10px 18px; border-radius: 7px; font-weight: 600; cursor: pointer; margin-bottom: 20px;">
                + Add Product
            </button>

            <div style="text-align: right; font-size: 18px; font-weight: 700; color: var(--black, #171717) !important; margin-bottom: 25px;">
                Estimated Total: R<span id="grandTotal">0.00</span>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">

                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceID"
                   style="padding: 10px 24px; border-radius: 7px; text-decoration: none !important; background-color: var(--dark-grey, #343434) !important; color: var(--white, #FFFFFF) !important; border: 1px solid var(--dark-grey, #343434) !important; font-weight: 600;">
                    Cancel
                </a>

                <button type="submit"
                        style="background-color: var(--primary, #D4A72C) !important; color: var(--black, #171717) !important; border: none !important; padding: 10px 24px; border-radius: 7px; font-weight: 600; cursor: pointer;">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

<template id="itemRowTemplate">
    <div class="invoice-item-row"
         style="display: grid; grid-template-columns: 2fr 100px 140px 120px 40px; gap: 10px; align-items: center; margin-bottom: 10px; color: var(--black, #171717) !important;">

        <select name="InvoiceItems[__INDEX__].ProductID" class="item-product" required
                style="height: 42px; padding: 6px 10px; border: 1px solid var(--grey, #777777) !important; border-radius: 7px; background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important;">

            <option value="">Select a product...</option>

            @foreach (var product in productsList)
            {
                <option value="@product.ProductID"
                        data-price="@product.Price">
                    @product.ProductName (R @product.Price.ToString("N2"))
                </option>
            }

        </select>

        <input type="number" name="InvoiceItems[__INDEX__].Quantity" class="item-quantity" min="1" value="1" required
               style="height: 42px; padding: 6px 10px; border: 1px solid var(--grey, #777777) !important; border-radius: 7px; background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important;" />

        <input type="number" step="0.01" name="InvoiceItems[__INDEX__].UnitPrice" class="item-unitprice" min="0"
               placeholder="Default price"
               style="height: 42px; padding: 6px 10px; border: 1px solid var(--grey, #777777) !important; border-radius: 7px; background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important;" />

        <span class="item-linetotal"
              style="font-weight: 600; color: var(--black, #171717) !important;">
            R0.00
        </span>

        <button type="button" class="remove-item-btn"
                style="background-color: var(--danger, #B54747) !important; color: var(--white, #FFFFFF) !important; border: none !important; border-radius: 7px; height: 42px; cursor: pointer;">
            X
        </button>

    </div>
</template>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const itemsContainer = document.getElementById("itemsContainer");
        const template = document.getElementById("itemRowTemplate").innerHTML;
        let rowIndex = 0;

        const existingItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InvoiceItems));

        function calculateLineTotal(row) {
            const select = row.querySelector(".item-product");
            const quantityInput = row.querySelector(".item-quantity");
            const unitPriceInput = row.querySelector(".item-unitprice");
            const lineTotalSpan = row.querySelector(".item-linetotal");

            const selectedOption = select.options[select.selectedIndex];
            const defaultPrice = selectedOption ? parseFloat(selectedOption.dataset.price || 0) : 0;
            const unitPrice = unitPriceInput.value ? parseFloat(unitPriceInput.value) : defaultPrice;
            const quantity = parseFloat(quantityInput.value) || 0;

            const lineTotal = quantity * unitPrice;
            lineTotalSpan.textContent = "R" + lineTotal.toFixed(2);

            updateGrandTotal();
        }

        function updateGrandTotal() {
            let total = 0;
            document.querySelectorAll(".invoice-item-row").forEach(function (row) {
                const text = row.querySelector(".item-linetotal").textContent.replace("R", "");
                total += parseFloat(text) || 0;
            });
            document.getElementById("grandTotal").textContent = total.toFixed(2);
        }

        function reindexRows() {
            const rows = itemsContainer.querySelectorAll(".invoice-item-row");
            rows.forEach(function (row, i) {
                row.querySelectorAll("[name]").forEach(function (field) {
                    field.name = field.name.replace(/\[\d+\]/, "[" + i + "]");
                });
            });
            rowIndex = rows.length;
        }

        function addRow(existingItem) {
            const html = template.replaceAll("__INDEX__", rowIndex);
            const wrapper = document.createElement("div");
            wrapper.innerHTML = html.trim();
            const row = wrapper.firstElementChild;

            itemsContainer.appendChild(row);
            rowIndex++;

            if (existingItem) {
                row.querySelector(".item-product").value = existingItem.productID;
                row.querySelector(".item-quantity").value = existingItem.quantity;
                row.querySelector(".item-unitprice").value = existingItem.unitPrice;
            }

            calculateLineTotal(row);

            row.querySelector(".item-product").addEventListener("change", function () {

             const selectedOption = this.options[this.selectedIndex];
              const unitPriceInput = row.querySelector(".item-unitprice");

            if (selectedOption.value !== "") 
             {
                  unitPriceInput.value = selectedOption.dataset.price;
             }
             else {
                  unitPriceInput.value = "";
             }

             calculateLineTotal(row);

            });
            row.querySelector(".item-quantity").addEventListener("input", function () { calculateLineTotal(row); });
            row.querySelector(".item-unitprice").addEventListener("input", function () { calculateLineTotal(row); });
            row.querySelector(".remove-item-btn").addEventListener("click", function () {
                row.remove();
                reindexRows();
                updateGrandTotal();
            });
        }

        document.getElementById("addItemBtn").addEventListener("click", function () { addRow(null); });

        if (existingItems && existingItems.length > 0) {
            existingItems.forEach(function (item) { addRow(item); });
        } else {
            addRow(null);
        }
    </script>
}
