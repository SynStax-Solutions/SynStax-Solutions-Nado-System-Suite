@model Nado_Graphics_MS_Frontend.Models.SupplierModel

@{
    ViewData["Title"] = "Create Supplier";
}

<div style="width: 100%;">

    <div style="margin-bottom: 25px;">

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: #24463A;
        ">
            Create Supplier
        </h1>

        <p style="
            margin: 5px 0 0 0;
            color: #555;
            font-size: 15px;
        ">
            Add a new supplier to the system.
        </p>

    </div>


    <div style="
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px; 
        align-items: start;">



        <div style="
            background-color: white;
            border: 2px solid black;
            border-radius: 14px;
            box-shadow: 0 6px 14px rgba(0,0,0,0.20);
            padding: 25px;">

            <h2 style="
                margin: 0;
                color: #24463A;
                font-size: 21px;
                font-weight: 700;
                padding-bottom: 10px;
                border-bottom: 2px solid #68926D;">
                New Supplier
            </h2>


            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     style=" color: #D46271;  margin-top: 15px; ">
                </div>


                <!-- Supplier Name -->
                <div style="margin-top: 20px;">

                    <label asp-for="SupplierName"
                           style="
                                display: block;
                                font-weight: 600;
                                margin-bottom: 7px;">
                        Supplier Name
                        <span style="color: #D46271;">*</span>
                    </label>

                    <input asp-for="SupplierName"
                           class="form-control"
                           placeholder="Enter supplier name"
                           style="
                                border: 2px solid black;
                                border-radius: 7px;
                                padding: 10px;" />

                    <span asp-validation-for="SupplierName"
                          style="color: #D46271;">
                    </span>

                </div>


                <div style="margin-top: 18px;">

                    <label asp-for="ContactNumber"
                           style="
                                display: block;
                                font-weight: 600;
                                margin-bottom: 7px;">
                        Contact Number
                    </label>

                    <input asp-for="ContactNumber"
                           class="form-control"
                           placeholder="Contact number"
                           style="
                                border: 2px solid black;
                                border-radius: 7px;
                                padding: 10px;" />

                    <span asp-validation-for="ContactNumber"
                          style="color: #D46271;">
                    </span>

                </div>

                <div style="margin-top: 18px;">

                    <label asp-for="SupplierEmail"
                           style="
                                display: block;
                                font-weight: 600;
                                margin-bottom: 7px;">
                        Email Address
                    </label>

                    <input asp-for="SupplierEmail"
                           type="email"
                           class="form-control"
                           placeholder="Supplier email"
                           style="
                                border: 2px solid black;
                                border-radius: 7px;
                                padding: 10px;
                           " />

                    <span asp-validation-for="SupplierEmail"
                          style="color: #D46271;">
                    </span>

                </div>

                <div style="margin-top: 18px;">

                    <label asp-for="SupplierAddress"
                           style="
                                display: block;
                                font-weight: 600;
                                margin-bottom: 7px;">
                        Supplier Address
                    </label>

                    <textarea asp-for="SupplierAddress"
                              class="form-control"
                              placeholder="Supplier address"
                              rows="3"
                              style="
                                    border: 2px solid black;
                                    border-radius: 7px;
                                    padding: 10px;">
                    </textarea>

                </div>

                <div style="margin-top: 18px;">

                    <label asp-for="LeadTime"
                           style="
                                display: block;
                                font-weight: 600;
                                margin-bottom: 7px;">
                        Lead Time
                        <span style="color: #D46271;">*</span>
                    </label>

                    <input asp-for="LeadTime"
                           class="form-control"
                           placeholder="e.g. 2 weeks, 3 months"
                           style="
                                border: 2px solid black;
                                border-radius: 7px;
                                padding: 10px;"/>

                    <span asp-validation-for="LeadTime"
                          style="color: #D46271;">
                    </span>

                </div>

                <div style="margin-top: 18px;">

                    <label asp-for="ServiceType"
                           style="
                                display: block;
                                font-weight: 600;
                                margin-bottom: 7px;">
                        Service Type
                        <span style="color: #D46271;">*</span>
                    </label>

                    <input asp-for="ServiceType"
                           class="form-control"
                           placeholder="e.g. Printing, Paper Supply"
                           style="
                                border: 2px solid black;
                                border-radius: 7px;
                                padding: 10px;"/>

                    <span asp-validation-for="ServiceType"
                          style="color: #D46271;">
                    </span>

                </div>
                <div style="margin-top: 18px;">

    <label asp-for="ServiceRate"
           style="
                display: block;
                font-weight: 600;
                margin-bottom: 7px;">
        Service Rate
    </label>

    <input asp-for="ServiceRate"
           type="number"
           step="0.01"
           min="0"
           class="form-control"
           placeholder="e.g. 250.00"
           style="
                border: 2px solid black;
                border-radius: 7px;
                                padding: 10px;"/>

                    <span asp-validation-for="ServiceRate"
                          style="color: #D46271;">
                    </span>

                </div>
                <div style="
                    display: flex;
                    justify-content: flex-end;
                    gap: 12px;
                    margin-top: 25px;">

                    <a asp-action="Index"
                       style="
                            background-color: #D46271;
                            color: white;
                            text-decoration: none;
                            padding: 11px 22px;
                            border-radius: 7px;
                            font-weight: 600;">
                        <i class="bi bi-x-lg"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            style="
                                background-color: #5A93C8;
                                color: white;
                                border: none;
                                padding: 11px 22px;
                                border-radius: 7px;
                                font-weight: 600;">
                        <i class="bi bi-check-lg"></i>
                        Create Supplier
                    </button>

                </div>

            </form>

        </div>

        <div style="
            background-color: white;
            border: 2px solid black;
            border-radius: 14px;
            box-shadow: 0 6px 14px rgba(0,0,0,0.20);
            padding: 25px; ">

            <h2 style="
                margin: 0;
                color: #24463A;
                font-size: 21px;
                font-weight: 700;
                padding-bottom: 10px;
                border-bottom: 2px solid #68926D;">
                Existing Suppliers
            </h2>


            <div style="
                margin-top: 20px;
                max-height: 650px;
                overflow-y: auto;
                padding-right: 5px;">

                @if (ViewBag.Suppliers != null &&
                     ViewBag.Suppliers.Count > 0)
                {
                    foreach (var supplier in ViewBag.Suppliers)
                    {
                        <div style="
                            border: 1px solid #ccc;
                            border-radius: 10px;
                            padding: 16px;
                            margin-bottom: 15px;
                            background-color: #f9faf9;">

                            <div style="
                                display: flex;
                                justify-content: space-between;
                                align-items: flex-start;
                                gap: 10px;">

                                <div>

                                    <h3 style="
                                        margin: 0;
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: #24463A;">
                                        @supplier.SupplierName
                                    </h3>

                                    <div style="
                                        margin-top: 7px;
                                        color: #555;
                                        font-size: 14px;">
                                        <strong>Service:</strong>
                                        @supplier.ServiceType
                                    </div>

                                </div>


                                <a asp-action="Edit"
                                   asp-route-id="@supplier.SupplierID"
                                   style="
                                        background-color: #5A93C8;
                                        color: white;
                                        text-decoration: none;
                                        padding: 7px 12px;
                                        border-radius: 6px;
                                        font-size: 13px;
                                        font-weight: 600;
                                        white-space: nowrap;">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>

                            </div>


                            <div style="
                                margin-top: 12px;
                                display: grid;
                                grid-template-columns: 1fr 1fr;
                                gap: 8px;
                                font-size: 13px;">

                                <div>
                                    <strong>Email:</strong><br />

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.SupplierEmail)
                                        ? "—" : supplier.SupplierEmail)
                                </div>

                                <div>
                                    <strong>Contact:</strong><br />

                                    @(string.IsNullOrWhiteSpace(
                                        supplier.ContactNumber)
                                        ? "—" : supplier.ContactNumber)
                                </div>

                                <div style="grid-column: 1 / -1;">

                                    <strong>Lead Time:</strong><br />

                                    @supplier.LeadTime

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div style="
                        text-align: center;
                        color: #777;
                        padding: 30px 10px;
                    ">
                        No suppliers have been added yet.
                    </div>
                }

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}