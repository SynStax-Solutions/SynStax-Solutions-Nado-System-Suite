@model Nado_Graphics_MS_Frontend.Models.SupplierModel

@{
    ViewData["Title"] = "Edit Supplier";
}

<div style="width: 100%;">

    <div style="margin-bottom: 25px;">

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: #24463A;">
            Edit Supplier
        </h1>

        <p style="
            margin: 5px 0 0 0;
            color: #555;
            font-size: 15px;">
            Edit the details of @Model.SupplierName.
        </p>

    </div>

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.20);
        padding: 25px;
        max-width: 700px; ">

        <h2 style="
            margin: 0;
            color: #24463A;
            font-size: 21px;
            font-weight: 700;
            padding-bottom: 10px;
            border-bottom: 2px solid #68926D; ">
            Supplier Information
        </h2>


        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="SupplierID" />


            <div asp-validation-summary="ModelOnly"
                 style="
                    color: #D46271;
                    margin-top: 15px; ">
            </div>


            <div style="margin-top: 20px;">

                <label asp-for="SupplierName"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px; ">
                    Supplier Name
                    <span style="color: #D46271;">*</span>
                </label>

                <input asp-for="SupplierName"
                       class="form-control"
                       placeholder="Enter supplier name"
                       style="
                            border: 2px solid black;
                            border-radius: 7px;
                            padding: 10px; "/>

                <span asp-validation-for="SupplierName"
                      style="color: #D46271;">
                </span>

            </div>


            <div style="margin-top: 18px;">

                <label asp-for="ContactNumber"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;">
                    Contact Number
                </label>

                <input asp-for="ContactNumber"
                       class="form-control"
                       placeholder="Contact number"
                       style="
                            border: 2px solid black;
                            border-radius: 7px;
                            padding: 10px;" />

                <span asp-validation-for="ContactNumber"
                      style="color: #D46271;">
                </span>

            </div>

            <div style="margin-top: 18px;">

                <label asp-for="SupplierEmail"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px; ">
                    Email Address
                </label>

                <input asp-for="SupplierEmail"
                       type="email"
                       class="form-control"
                       placeholder="Supplier email"
                       style="
                            border: 2px solid black;
                            border-radius: 7px;
                            padding: 10px; "/>

                <span asp-validation-for="SupplierEmail"
                      style="color: #D46271;">
                </span>

            </div>

            <div style="margin-top: 18px;">

                <label asp-for="SupplierAddress"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;
                       ">
                    Supplier Address
                </label>

                <textarea asp-for="SupplierAddress"
                          class="form-control"
                          placeholder="Supplier address"
                          rows="3"
                          style="
                                border: 2px solid black;
                                border-radius: 7px;
                                padding: 10px;
                          ">
                </textarea>

            </div>

            <div style="margin-top: 18px;">

                <label asp-for="LeadTime"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px; ">
                    Lead Time
                    <span style="color: #D46271;">*</span>
                </label>

                <input asp-for="LeadTime"
                       class="form-control"
                       placeholder="e.g. 2 weeks, 3 months"
                       style="
                            border: 2px solid black;
                            border-radius: 7px;
                            padding: 10px; "/>

                <span asp-validation-for="LeadTime"
                      style="color: #D46271;">
                </span>

            </div>

            <div style="margin-top: 18px;">

                <label asp-for="ServiceType"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px; ">
                    Service Type
                    <span style="color: #D46271;">*</span>
                </label>

                <input asp-for="ServiceType"
                       class="form-control"
                       placeholder="e.g. Printing, Paper Supply"
                       style="
                            border: 2px solid black;
                            border-radius: 7px;
                            padding: 10px; "/>

                <span asp-validation-for="ServiceType"
                      style="color: #D46271;">
                </span>

            </div>
            <div style="margin-top: 18px;">

    <label asp-for="ServiceRate"
           style="
                display: block;
                font-weight: 600;
                margin-bottom: 7px;">
        Service Rate
    </label>

    <input asp-for="ServiceRate"
           type="number"
           step="0.01"
           min="0"
           class="form-control"
           placeholder="e.g. 250.00"
           style="
                border: 2px solid black;
                border-radius: 7px;
                padding: 10px;"/>

    <span asp-validation-for="ServiceRate"
          style="color: #D46271;">
    </span>

</div>

            <div style="
                display: flex;
                justify-content: flex-end;
                gap: 12px;
                margin-top: 25px; ">

                <a asp-action="Create"
                   style="
                        background-color: #D46271;
                        color: white;
                        text-decoration: none;
                        padding: 11px 22px;
                        border-radius: 7px;
                        font-weight: 600; ">
                    Cancel
                </a>

                <button type="submit"
                        style="
                            background-color: #5A93C8;
                            color: white;
                            border: none;
                            padding: 11px 22px;
                            border-radius: 7px;
                            font-weight: 600;">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}