
@model List<Nado_Graphics_MS_Frontend.Models.SupplierModel>

@{
    ViewData["Title"] = "Manage Suppliers";
}

@* This page shows a list of all suppliers. *@
<div class="container mt-5">

    <h1 style="color: var(--black, #171717) !important;">
        Manage Suppliers
    </h1>

    <p class="text-muted" style="color: var(--grey, #777777) !important;">
        View, edit and delete suppliers.
    </p>

    @* This shows an error message, e.g. if a supplier couldn't be deleted. *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"
             style="
                background: var(--danger, #B54747) !important;
                background-color: var(--danger, #B54747) !important;
                color: var(--white, #FFFFFF) !important;
                border-color: var(--danger, #B54747) !important;">
            @TempData["Error"]
        </div>
    }

    <!-- CREATE SUPPLIER BUTTON -->
    <a asp-controller="Suppliers"
       asp-action="Create"
       class="btn btn-success mb-3"
       style="
            background: var(--primary, #D4A72C) !important;
            background-color: var(--primary, #D4A72C) !important;
            color: var(--black, #171717) !important;
            border-color: var(--primary, #D4A72C) !important;
            text-decoration: none;">
        Create Supplier
    </a>

    @* This shows a message if there are no suppliers yet. *@
    @if (!Model.Any())
    {
        <p class="text-muted" style="color: var(--grey, #777777) !important;">
            No suppliers have been added yet.
        </p>
    }
    else
    {
        <table class="table table-bordered table-striped"
               style="
                    background-color: var(--white, #FFFFFF);
                    border: 2px solid var(--black, #171717);
                    border-radius: 12px;
                    overflow: visible;
                    position: relative;
                    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.30);">

            <!-- SOLID BLACK TABLE HEADER -->
            <thead style="
                background: var(--black, #171717) !important;
                background-color: var(--black, #171717) !important;
                color: var(--white, #FFFFFF) !important;">

                <tr style="
                    background: var(--black, #171717) !important;
                    background-color: var(--black, #171717) !important;
                    color: var(--white, #FFFFFF) !important;">

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Supplier Name
                    </th>

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Contact Number
                    </th>

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Email Address
                    </th>

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Service Type
                    </th>

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Service Rate
                    </th>

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Lead Time
                    </th>

                    <th style="background: var(--black, #171717) !important; background-color: var(--black, #171717) !important; color: var(--white, #FFFFFF) !important; padding: 14px;">
                        Manage Supplier
                    </th>

                </tr>

            </thead>

            <tbody>

                @* This loops through every supplier and makes one row for each. *@
                @foreach (var supplier in Model)
                {
                    <tr>

                        <td style="padding: 14px; color: var(--black, #171717);">
                            @supplier.SupplierName
                        </td>

                        <td style="padding: 14px; color: var(--black, #171717);">
                            @supplier.ContactNumber
                        </td>

                        <td style="padding: 14px; color: var(--black, #171717);">
                            @supplier.SupplierEmail
                        </td>

                        <td style="padding: 14px; color: var(--black, #171717);">
                            @supplier.ServiceType
                        </td>

                        <td style="padding: 14px; color: var(--black, #171717);">
                            @(supplier.ServiceRate.HasValue ? $"R{supplier.ServiceRate.Value:N2}" : "Not set")
                        </td>

                        <td style="padding: 14px; color: var(--black, #171717);">
                            @supplier.LeadTime
                        </td>

                        <td style="padding: 14px;">

                            <div class="dropdown">

                                <!-- MUSTARD MANAGE BUTTON -->
                                <button class="btn dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        style="
                                            background: var(--primary, #D4A72C) !important;
                                            background-color: var(--primary, #D4A72C) !important;
                                            color: var(--black, #171717) !important;
                                            border: none !important;
                                            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.20);">
                                    Manage
                                </button>

                                <ul class="dropdown-menu"
                                    style="
                                        background-color: var(--white, #FFFFFF);
                                        border-color: var(--light-grey, #E5E5E5);">

                                    <!-- VIEW -->
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Suppliers"
                                           asp-action="Details"
                                           asp-route-id="@supplier.SupplierID"
                                           style="color: var(--black, #171717);">
                                            View
                                        </a>
                                    </li>

                                    <!-- EDIT -->
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Suppliers"
                                           asp-action="Edit"
                                           asp-route-id="@supplier.SupplierID"
                                           style="color: var(--black, #171717);">
                                            Edit
                                        </a>
                                    </li>

                                    @* Delete is a form (POST) so it can't be triggered by just opening a link. *@
                                    <li>
                                        <form asp-controller="Suppliers"
                                              asp-action="Delete"
                                              asp-route-id="@supplier.SupplierID"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item"
                                                    style="
                                                        color: var(--danger, #B54747) !important;
                                                        font-weight: 600;"
                                                    onclick="return confirm('Are you sure you want to delete this supplier?');">
                                                Delete
                                            </button>

                                        </form>
                                    </li>

                                </ul>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>

