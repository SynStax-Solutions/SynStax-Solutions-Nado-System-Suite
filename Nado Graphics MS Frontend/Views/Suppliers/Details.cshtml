
@model Nado_Graphics_MS_Frontend.Models.SupplierModel

@{
    ViewData["Title"] = "Supplier Details";
}

<div style="width: 100%;">

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 25px;">

        <div>

            <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: var(--black, #171717) !important;">
                Supplier Details
            </h1>

            <p style="margin: 5px 0 0 0; color: var(--grey, #777777) !important; font-size: 15px;">
                View the details of @Model.SupplierName.
            </p>

        </div>

        <a asp-action="Index"
           style="background-color: var(--dark-grey, #343434) !important; color: var(--white, #FFFFFF) !important; text-decoration: none !important; padding: 11px 20px; border-radius: 7px; font-weight: 600;">
            Back to Suppliers
        </a>

    </div>

    <div style="background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important; border: 2px solid var(--black, #171717) !important; border-radius: 14px; box-shadow: 0 6px 14px rgba(0,0,0,0.20); padding: 25px; max-width: 900px;">

        <h2 style="margin: 0; color: var(--black, #171717) !important; font-size: 21px; font-weight: 700; padding-bottom: 10px; border-bottom: 2px solid var(--primary, #D4A72C) !important;">
            Supplier Information
        </h2>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 25px;">

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Supplier Name
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @Model.SupplierName
                </div>

            </div>

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Service Type
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @Model.ServiceType
                </div>

            </div>

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Contact Number
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @(string.IsNullOrWhiteSpace(Model.ContactNumber) ? "—" : Model.ContactNumber)
                </div>

            </div>

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Email Address
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @(string.IsNullOrWhiteSpace(Model.SupplierEmail) ? "—" : Model.SupplierEmail)
                </div>

            </div>

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Lead Time
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @Model.LeadTime
                </div>

            </div>

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Supplier ID
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @Model.SupplierID
                </div>

            </div>

            <div style="grid-column: 1 / -1;">

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Supplier Address
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important; min-height: 45px;">
                    @(string.IsNullOrWhiteSpace(Model.SupplierAddress) ? "—" : Model.SupplierAddress)
                </div>

            </div>

            <div>

                <label style="display: block; font-weight: 600; margin-bottom: 7px; color: var(--black, #171717) !important;">
                    Created At
                </label>

                <div style="border: 2px solid var(--grey, #777777) !important; border-radius: 7px; padding: 10px; background-color: var(--background, #F5F5F5) !important; color: var(--black, #171717) !important;">
                    @Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                </div>

            </div>

        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 25px;">

            <a asp-action="Index"
               style="background-color: var(--dark-grey, #343434) !important; color: var(--white, #FFFFFF) !important; text-decoration: none !important; padding: 11px 22px; border-radius: 7px; font-weight: 600;">
                Back to Suppliers
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.SupplierID"
               style="background-color: var(--primary, #D4A72C) !important; color: var(--black, #171717) !important; text-decoration: none !important; padding: 11px 22px; border-radius: 7px; font-weight: 600;">
                Edit Supplier
            </a>

        </div>

    </div>

</div>

