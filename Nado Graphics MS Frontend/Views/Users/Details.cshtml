@model Nado_Graphics_MS_Frontend.Models.ViewUserModel

@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">

    <div style="margin-bottom: 25px;">

        <h1 style="
            color: #24463A;
            font-weight: 600;
            margin-bottom: 5px; ">
            User Details
        </h1>

        <p style="
            color: #6c757d;
            margin-bottom: 0;">
            View the information and account status of this user.
        </p>

    </div>

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);">

        <div style="
            background-color: #68926D;
            color: white;
            padding: 18px 25px;">

            <h4 style="
                margin: 0;
                font-weight: 600; ">
                Account Information
            </h4>

        </div>

        <div style="padding: 25px;">

            <div class="row">
                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px; ">
                        USER ID
                    </div>

                    <div style="
                        font-size: 17px;
                        font-weight: 500;
                        color: #212529; ">
                        @Model.UserID
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px; ">
                        ACCOUNT STATUS
                    </div>

                    @if (Model.IsActive)
                    {
                        <span style="
                            display: inline-block;
                            background-color: #68926D;
                            color: white;
                            padding: 6px 14px;
                            border-radius: 20px;
                            font-size: 14px;
                            font-weight: 600; ">
                            Active
                        </span>
                    }
                    else
                    {
                        <span style="
                            display: inline-block;
                            background-color: #D46271;
                            color: white;
                            padding: 6px 14px;
                            border-radius: 20px;
                            font-size: 14px;
                            font-weight: 600; ">
                            Inactive
                        </span>
                    }

                </div>


                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px; ">
                        FIRST NAME
                    </div>

                    <div style="
                        font-size: 17px;
                        color: #212529; ">
                        @Model.FirstName
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px;">
                        LAST NAME
                    </div>

                    <div style="
                        font-size: 17px;
                        color: #212529; ">
                        @Model.LastName
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px; ">
                        EMAIL ADDRESS
                    </div>

                    <div style="
                        font-size: 17px;
                        color: #212529; ">
                        @Model.Email
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px; ">
                        USER ROLE
                    </div>

                    <div style="
                        font-size: 17px;
                        color: #212529; ">
                        @Model.UserRole
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <div style="
                        color: #6c757d;
                        font-size: 13px;
                        font-weight: 600;
                        margin-bottom: 5px; ">
                        ACCOUNT CREATED
                    </div>

                    <div style="
                        font-size: 17px;
                        color: #212529; ">
                        @Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                    </div>

                </div>

            </div>


            <hr style="
                margin-top: 5px;
                margin-bottom: 20px;
                border: 0;
                border-top: 1px solid #d9dfda; " />


            <div style="
                display: flex;
                gap: 10px;
                flex-wrap: wrap; ">

                <a asp-action="Index"
                   class="btn"
                   style="
                       background-color: #68926D;
                       color: white;
                       border: none;
                       padding: 10px 18px;
                       border-radius: 7px;
                       box-shadow: 0 4px 8px rgba(0, 0, 0, 0.20); ">
                    Back to Users
                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.UserID"
                   class="btn"
                   style="
                       background-color: #5A93C8;
                       color: white;
                       border: none;
                       padding: 10px 18px;
                       border-radius: 7px;
                       box-shadow: 0 4px 8px rgba(0, 0, 0, 0.20); ">
                    Edit User
                </a>

            </div>

        </div>

    </div>

</div>