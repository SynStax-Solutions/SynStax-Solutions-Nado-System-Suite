
@model Nado_Graphics_MS_Frontend.Models.ViewUserModel

@{
    ViewData["Title"] = "Create User";
}

<div class="container mt-5">

    <!-- PAGE HEADING -->
    <h1 style="
        color: var(--black, #171717) !important;
        font-size: 32px;
        font-weight: 700;">
        Create User
    </h1>

    <p class="text-muted"
       style="
            color: var(--grey, #777777) !important;
            margin-bottom: 25px;">
        Create a new staff account. The new user must verify their email before they can log in.
    </p>

    <!-- CREATE USER FORM CARD -->
    <div style="
        background: var(--white, #FFFFFF) !important;
        background-color: var(--white, #FFFFFF) !important;
        border-radius: 14px;
        box-shadow: 0 5px 14px rgba(0,0,0,0.16);
        padding: 30px;
        max-width: 850px;">

        <form asp-action="Create" method="post">

            @* This shows errors from the API, e.g. "Email already exists". *@
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"
                 style="color: var(--danger, #B54747) !important;">
            </div>

            <!-- FIRST NAME -->
            <div class="mb-3">

                <label asp-for="FirstName"
                       class="form-label"
                       style="
                            color: var(--black, #171717) !important;
                            font-weight: 600;">
                    First Name
                </label>

                <input asp-for="FirstName"
                       class="form-control"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 1px solid var(--grey, #777777);
                            border-radius: 7px;
                            padding: 10px 12px;" />

                <span asp-validation-for="FirstName"
                      class="text-danger"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- LAST NAME -->
            <div class="mb-3">

                <label asp-for="LastName"
                       class="form-label"
                       style="
                            color: var(--black, #171717) !important;
                            font-weight: 600;">
                    Last Name
                </label>

                <input asp-for="LastName"
                       class="form-control"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 1px solid var(--grey, #777777);
                            border-radius: 7px;
                            padding: 10px 12px;" />

                <span asp-validation-for="LastName"
                      class="text-danger"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- EMAIL ADDRESS -->
            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label"
                       style="
                            color: var(--black, #171717) !important;
                            font-weight: 600;">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 1px solid var(--grey, #777777);
                            border-radius: 7px;
                            padding: 10px 12px;" />

                <span asp-validation-for="Email"
                      class="text-danger"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- PASSWORD -->
            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label"
                       style="
                            color: var(--black, #171717) !important;
                            font-weight: 600;">
                    Password
                </label>

                <input asp-for="Password"
                       class="form-control"
                       autocomplete="new-password"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 1px solid var(--grey, #777777);
                            border-radius: 7px;
                            padding: 10px 12px;" />

                <small class="text-muted"
                       style="
                            display: block;
                            margin-top: 6px;
                            color: var(--grey, #777777) !important;">
                    8 to 64 characters. The user will get a verification email before they can log in.
                </small>

                <span asp-validation-for="Password"
                      class="text-danger"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- USER ROLE -->
            <div class="mb-4">

                <label asp-for="UserRole"
                       class="form-label"
                       style="
                            color: var(--black, #171717) !important;
                            font-weight: 600;">
                    User Role
                </label>

                <select asp-for="UserRole"
                        class="form-select"
                        style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 1px solid var(--grey, #777777);
                            border-radius: 7px;
                            padding: 10px 12px;">

                    <option value="">-- Select Role --</option>

                    @* This only shows the roles the logged-in user is allowed to create.
                       e.g. a PA/Admin will only see Graphic Designer. *@
                    @foreach (var r in AppRoles.AssignableBy(User.FindFirst(ClaimTypes.Role)?.Value))
                    {
                        <option value="@r">
                            @(r == AppRoles.Manager ? "Manager (Owner)" : r)
                        </option>
                    }

                </select>

                <span asp-validation-for="UserRole"
                      class="text-danger"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- FORM ACTION BUTTONS -->
            <div style="
                display: flex;
                align-items: center;
                gap: 12px;
                margin-top: 25px;">

                <!-- MUSTARD CREATE BUTTON -->
                <button type="submit"
                        class="btn btn-success"
                        style="
                            background: var(--primary, #D4A72C) !important;
                            background-color: var(--primary, #D4A72C) !important;
                            color: var(--black, #171717) !important;
                            border-color: var(--primary, #D4A72C) !important;
                            border-radius: 7px;
                            padding: 10px 20px;
                            font-weight: 600;">
                    Create User
                </button>

                <!-- DARK GREY CANCEL BUTTON -->
                <a asp-action="Index"
                   class="btn btn-secondary"
                   style="
                        background: var(--dark-grey, #343434) !important;
                        background-color: var(--dark-grey, #343434) !important;
                        color: var(--white, #FFFFFF) !important;
                        border-color: var(--dark-grey, #343434) !important;
                        text-decoration: none !important;
                        border-radius: 7px;
                        padding: 10px 20px;
                        font-weight: 600;">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
