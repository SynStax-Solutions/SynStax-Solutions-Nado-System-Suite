@model List<Nado_Graphics_MS_Frontend.Models.ViewUserModel>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-5">

    <h1>Manage Users</h1>

    <p class="text-muted">
        Manage administrator, manager and graphic designer accounts.
    </p>

    <a asp-controller="Users"
       asp-action="Create"
       class="btn btn-success mb-3">
        Create User
    </a>

    <table class="table table-bordered table-striped"
       style="
           background-color: white;
           border: 2px solid black;
           border-radius: 12px;
           overflow: hidden;
           box-shadow: 0 10px 25px rgba(0, 0, 0, 0.30);">

    <thead>
        <tr>
            <th style="
                background-color: #68926D;
                color: white;
                padding: 14px; ">
                User Name
            </th>

            <th style="
                background-color: #68926D;
                color: white;
                padding: 14px; ">
                Email Address
            </th>

            <th style="
                background-color: #68926D;
                color: white;
                padding: 14px; ">
                User Role
            </th>

            <th style="
                background-color: #68926D;
                color: white;
                padding: 14px; ">
                Account Status
            </th>

            <th style="
                background-color: #68926D;
                color: white;
                padding: 14px; ">
                Manage Account
            </th>
        </tr>
    </thead>

    <tbody>

        @foreach (var user in Model)
        {
            <tr>
                <td style="padding: 14px;">
                    @user.FirstName @user.LastName
                </td>

                <td style="padding: 14px;">
                    @user.Email
                </td>

                <td style="padding: 14px;">
                    @user.UserRole
                </td>

                <td style="padding: 14px;">
                    @(user.IsActive ? "Active" : "Inactive")
                </td>

                <td style="padding: 14px;">

                    <div class="dropdown">

                        <button class="btn dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="
                                    background-color: #68926D;
                                    color: white;
                                    border: none;
                                    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.20); ">
                            Manage
                        </button>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Users"
                                   asp-action="Details"
                                   asp-route-id="@user.UserID">
                                    View
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Users"
                                   asp-action="Edit"
                                   asp-route-id="@user.UserID">
                                    Edit
                                </a>
                            </li>

                            <li>
                                <form asp-controller="Users"
                                      asp-action="Delete"
                                      asp-route-id="@user.UserID"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-item"
                                            onclick="return confirm('Are you sure you want to delete this user?');">
                                        Delete
                                    </button>

                                </form>
                            </li>

                        </ul>

                    </div>

                </td>
            </tr>
        }

    </tbody>

</table>

</div>