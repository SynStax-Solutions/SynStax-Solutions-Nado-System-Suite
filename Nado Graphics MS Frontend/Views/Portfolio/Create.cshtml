@model Nado_Graphics_MS_Frontend.Models.CreatePortfolioSubmissionViewModel

@{
    ViewData["Title"] = "Upload Portfolio Submission";
    var jobCards = (List<Nado_Graphics_MS_Frontend.Models.JobCardModel>)ViewBag.JobCards;
}

<div style="width: 100%; max-width: 700px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #24463A;">Upload Submission</h1>
        <a asp-controller="Portfolio" asp-action="Index"
               style="background-color: #68926D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>
    </div>

    <div style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); padding: 30px;">

        <form asp-controller="Portfolio" asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" style="color: #C85A5A; margin-bottom: 15px;"></div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-weight: 600; color: #24463A; margin-bottom: 6px;">Title</label>
                <input asp-for="Title" maxlength="150"
                       style="width: 100%; height: 44px; padding: 8px 12px; border: 1px solid #aaa; border-radius: 7px;" />
                <span asp-validation-for="Title" style="color: #C85A5A; font-size: 13px;"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-weight: 600; color: #24463A; margin-bottom: 6px;">Description</label>
                <textarea asp-for="Description" rows="3" maxlength="1000"
                          style="width: 100%; padding: 10px 12px; border: 1px solid #aaa; border-radius: 7px; resize: vertical;"></textarea>
                <span asp-validation-for="Description" style="color: #C85A5A; font-size: 13px;"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-weight: 600; color: #24463A; margin-bottom: 6px;">Link to a job card (optional)</label>
                <select asp-for="JobCardID" style="width: 100%; height: 44px; padding: 8px 12px; border: 1px solid #aaa; border-radius: 7px;">
                    <option value="">No job card - standalone submission</option>
                    @foreach (var jobCard in jobCards)
                    {
                        <option value="@jobCard.JobCardID">@jobCard.ReferenceNumber - @jobCard.JobTitle</option>
                    }
                </select>
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; font-weight: 600; color: #24463A; margin-bottom: 6px;">File</label>
                <input asp-for="MediaFile" type="file" id="mediaFile" accept=".png,.jpg,.jpeg,.gif,.webp,.pdf"
                       style="width: 100%; padding: 8px 12px; border: 1px solid #aaa; border-radius: 7px; background-color: white;" />
                <div style="color: #777; font-size: 12px; margin-top: 4px;">PNG, JPG, GIF, WEBP or PDF. Maximum 10 MB.</div>
                <span asp-validation-for="MediaFile" style="color: #C85A5A; font-size: 13px;"></span>
                <div id="fileError" style="color: #C85A5A; font-size: 13px;"></div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <a asp-controller="Portfolio" asp-action="Index"
                       style="padding: 10px 24px; border-radius: 7px; text-decoration: none; color: #24463A; border: 1px solid #aaa; font-weight: 600;">
                    Cancel
                </a>
                <button type="submit"
                        style="background-color: #68926D; color: white; border: none; padding: 10px 24px; border-radius: 7px; font-weight: 600; cursor: pointer;">
                    Upload
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Quick check in the browser so a too-big file is caught before it uploads.
        document.getElementById("mediaFile").addEventListener("change", function () {
            const error = document.getElementById("fileError");
            error.textContent = "";

            if (this.files.length > 0 && this.files[0].size > 10 * 1024 * 1024) {
                error.textContent = "The file is too large. The maximum size is 10 MB.";
                this.value = "";
            }
        });
    </script>
}