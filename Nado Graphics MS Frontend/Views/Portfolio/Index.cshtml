@model List<Nado_Graphics_MS_Frontend.Models.PortfolioSubmissionModel>

@{
    ViewData["Title"] = "Portfolio Submissions";

    var canDelete = User.IsInRole(Nado_Graphics_MS_Frontend.Security.AppRoles.Manager)
                 || User.IsInRole(Nado_Graphics_MS_Frontend.Security.AppRoles.Admin);

    int? jobCardId = ViewBag.JobCardId;
}

<div style="width: 100%;">

    <!-- PAGE HEADING AND BACK BUTTON -->
    <div style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;">

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: var(--black, #171717) !important;">
            Portfolio Submissions
        </h1>

        <a asp-controller="Owner"
           asp-action="Dashboard"
           style="
            background: var(--dark-grey, #343434) !important;
            background-color: var(--dark-grey, #343434) !important;
            color: var(--white, #FFFFFF) !important;
            text-decoration: none !important;
            padding: 10px 20px;
            border-radius: 7px;
            font-weight: 600;
            border: none;">
            Back
        </a>

    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div style="
            background: var(--success, #47785B) !important;
            background-color: var(--success, #47785B) !important;
            color: var(--white, #FFFFFF) !important;
            padding: 12px 16px;
            border-radius: 7px;
            margin-bottom: 20px;">
            @TempData["Success"]
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div style="
            background: var(--danger, #B54747) !important;
            background-color: var(--danger, #B54747) !important;
            color: var(--white, #FFFFFF) !important;
            padding: 12px 16px;
            border-radius: 7px;
            margin-bottom: 20px;">
            @TempData["Error"]
        </div>
    }

    <!-- JOB CARD FILTER MESSAGE -->
    @if (jobCardId != null)
    {
        <div style="
            background: var(--background, #F5F5F5) !important;
            background-color: var(--background, #F5F5F5) !important;
            color: var(--black, #171717) !important;
            padding: 12px 16px;
            border-radius: 7px;
            margin-bottom: 20px;">

            Showing submissions linked to one job card.

            <a asp-action="Index"
               style="
                color: var(--primary-hover, #B88C1F) !important;
                font-weight: 600;">
                Show all
            </a>

        </div>
    }

    <!-- SEARCH AND UPLOAD BUTTON -->
    <div style="
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;">

        <div style="flex: 1;">

            <input type="text"
                   id="portfolioSearch"
                   placeholder="Search by title, uploader or job card..."
                   style="
            width: 100%;
            height: 44px;
            padding: 8px 15px;
            border: 1px solid var(--grey, #777777);
            border-radius: 7px;
            font-size: 15px;
            outline: none;
            background-color: var(--white, #FFFFFF);
            color: var(--black, #171717);" />

        </div>

        <a asp-controller="Portfolio"
           asp-action="Create"
           asp-route-jobCardId="@jobCardId"
           style="
            height: 44px;
            display: flex;
            align-items: center;
            background: var(--primary, #D4A72C) !important;
            background-color: var(--primary, #D4A72C) !important;
            color: var(--black, #171717) !important;
            text-decoration: none !important;
            padding: 0 20px;
            border-radius: 7px;
            font-weight: 600;
            white-space: nowrap;
            border: none;">
            Upload Submission
        </a>

    </div>

    <!-- PORTFOLIO CONTENT -->
    @if (Model == null || !Model.Any())
    {
        <div style="
            background-color: var(--white, #FFFFFF);
            border-radius: 14px;
            box-shadow: 0 5px 14px rgba(0,0,0,0.16);
            padding: 55px 20px;
            text-align: center;
            color: var(--grey, #777777);">

            <h3 style="
                margin-top: 12px;
                color: var(--black, #171717);">
                No Submissions Found
            </h3>

            <p style="margin-bottom: 0;">
                Nothing has been uploaded yet.
            </p>

        </div>
    }
    else
    {
        <div style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;">

            @foreach (var s in Model)
            {
                <!-- PORTFOLIO CARD -->
                <div class="portfolio-card"
                     data-search="@($"{s.Title} {s.SubmittedByName} {s.JobCardReference}".ToLower())"
                     style="
                    background: var(--white, #FFFFFF) !important;
                    background-color: var(--white, #FFFFFF) !important;
                    border-radius: 14px;
                    box-shadow: 0 5px 14px rgba(0,0,0,0.16);
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;">

                    <!-- IMAGE OR PDF PREVIEW -->
                    <a asp-action="Media"
                       asp-route-id="@s.SubmissionID"
                       target="_blank"
                       style="
                        display: block;
                        height: 180px;
                        background: var(--background, #F5F5F5) !important;
                        background-color: var(--background, #F5F5F5) !important;
                        text-decoration: none !important;">

                        @if (s.IsImage)
                        {
                            <img src="@Url.Action("Media", "Portfolio", new { id = s.SubmissionID })"
                                 alt="@s.Title"
                                 style="
                            width: 100%;
                            height: 100%;
                            object-fit: cover;" />
                        }
                        else
                        {
                            <div style="
                                height: 100%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                color: var(--black, #171717) !important;
                                font-weight: 700;
                                font-size: 22px;">
                                PDF
                            </div>
                        }

                    </a>

                    <!-- SUBMISSION INFORMATION -->
                    <div style="
                        padding: 16px;
                        flex: 1;
                        color: var(--black, #171717);">

                        <!-- TITLE -->
                        <div style="
                            font-weight: 700;
                            color: var(--black, #171717) !important;
                            font-size: 16px;
                            margin-bottom: 4px;">
                            @s.Title
                        </div>

                        <!-- DESCRIPTION -->
                        @if (!string.IsNullOrWhiteSpace(s.Description))
                        {
                            <div style="
                                color: var(--grey, #777777) !important;
                                font-size: 13px;
                                margin-bottom: 8px;">
                                @s.Description
                            </div>
                        }

                        <!-- UPLOADER AND DATE -->
                        <div style="
                            color: var(--grey, #777777) !important;
                            font-size: 12px;">
                            By @s.SubmittedByName on @s.DateSubmitted.ToString("dd MMM yyyy")
                        </div>

                        <!-- LINKED JOB CARD -->
                        @if (s.JobCardID != null)
                        {
                            <div style="margin-top: 8px;">

                                <span style="
                                    background: var(--dark-grey, #343434) !important;
                                    background-color: var(--dark-grey, #343434) !important;
                                    color: var(--white, #FFFFFF) !important;
                                    padding: 2px 8px;
                                    border-radius: 10px;
                                    font-size: 11px;
                                    font-weight: 600;">
                                    Job Card @s.JobCardReference
                                </span>

                            </div>
                        }

                    </div>

                    <!-- CARD ACTION BUTTONS -->
                    <div style="
                        display: flex;
                        gap: 8px;
                        padding: 0 16px 16px;">

                        <!-- MUSTARD VIEW BUTTON -->
                        <a asp-action="Media"
                           asp-route-id="@s.SubmissionID"
                           target="_blank"
                           style="
                            flex: 1;
                            text-align: center;
                            background: var(--primary, #D4A72C) !important;
                            background-color: var(--primary, #D4A72C) !important;
                            color: var(--black, #171717) !important;
                            text-decoration: none !important;
                            padding: 8px;
                            border-radius: 7px;
                            font-weight: 600;
                            font-size: 13px;">
                            View
                        </a>

                        <!-- RED DELETE BUTTON -->
                        @if (canDelete)
                        {
                            <form asp-action="Delete"
                                  asp-route-id="@s.SubmissionID"
                                  method="post"
                                  style="
                                flex: 1;
                                margin: 0;">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        onclick="return confirm('Are you sure you want to delete this submission?');"
                                        style="
                                    width: 100%;
                                    background: var(--danger, #B54747) !important;
                                    background-color: var(--danger, #B54747) !important;
                                    color: var(--white, #FFFFFF) !important;
                                    border: none !important;
                                    padding: 8px;
                                    border-radius: 7px;
                                    font-weight: 600;
                                    font-size: 13px;
                                    cursor: pointer;">
                                    Delete
                                </button>

                            </form>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>

@section Scripts {

    <script>

        const searchInput = document.getElementById("portfolioSearch");

        const cards = document.querySelectorAll(".portfolio-card");

        searchInput.addEventListener("input", function () {

            const value = searchInput.value.toLowerCase().trim();

            cards.forEach(function (card) {

                card.style.display =
                    card.dataset.search.includes(value) ? "flex" : "none";

            });

        });

    </script>

}

