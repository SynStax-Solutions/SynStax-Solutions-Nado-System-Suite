@model List<Nado_Graphics_MS_Frontend.Models.PortfolioSubmissionModel>

@{
    ViewData["Title"] = "Portfolio Submissions";
    var canDelete = User.IsInRole(Nado_Graphics_MS_Frontend.Security.AppRoles.Manager)
                 || User.IsInRole(Nado_Graphics_MS_Frontend.Security.AppRoles.Admin);
    int? jobCardId = ViewBag.JobCardId;
}

<div style="width: 100%;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #24463A;">Portfolio Submissions</h1>
        <a asp-controller="Owner" asp-action="Dashboard"
               style="background-color: #68926D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background-color: #DCEEDC; color: #24463A; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background-color: #F8D7DA; color: #842029; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">@TempData["Error"]</div>
    }

    @if (jobCardId != null)
    {
        <div style="background-color: #E8F0F8; color: #24463A; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">
            Showing submissions linked to one job card.
            <a asp-action="Index" style="color: #24463A; font-weight: 600;">Show all</a>
        </div>
    }

    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 25px;">
        <div style="flex: 1;">
            <input type="text" id="portfolioSearch" placeholder="Search by title, uploader or job card..."
                   style="width: 100%; height: 44px; padding: 8px 15px; border: 1px solid #aaa; border-radius: 7px; font-size: 15px; outline: none;" />
        </div>
        <a asp-controller="Portfolio" asp-action="Create" asp-route-jobCardId="@jobCardId"
               style="height: 44px; display: flex; align-items: center; background-color: #5A93C8; color: white; text-decoration: none; padding: 0 20px; border-radius: 7px; font-weight: 600; white-space: nowrap;">
            Upload Submission
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); padding: 55px 20px; text-align: center; color: #666;">
            <h3 style="margin-top: 12px; color: #24463A;">No Submissions Found</h3>
            <p style="margin-bottom: 0;">Nothing has been uploaded yet.</p>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px;">
            @foreach (var s in Model)
            {
                <div class="portfolio-card"
                     data-search="@($"{s.Title} {s.SubmittedByName} {s.JobCardReference}".ToLower())"
                     style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); overflow: hidden; display: flex; flex-direction: column;">

                    <a asp-action="Media" asp-route-id="@s.SubmissionID" target="_blank"
                           style="display: block; height: 180px; background-color: #f0f0f0; text-decoration: none;">
                        @if (s.IsImage)
                        {
                            <img src="@Url.Action("Media", "Portfolio", new { id = s.SubmissionID })" alt="@s.Title"
                                 style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <div style="height: 100%; display: flex; align-items: center; justify-content: center; color: #24463A; font-weight: 700; font-size: 22px;">
                                PDF
                            </div>
                        }
                    </a>

                    <div style="padding: 16px; flex: 1;">
                        <div style="font-weight: 700; color: #24463A; font-size: 16px; margin-bottom: 4px;">@s.Title</div>
                        @if (!string.IsNullOrWhiteSpace(s.Description))
                        {
                            <div style="color: #555; font-size: 13px; margin-bottom: 8px;">@s.Description</div>
                        }
                        <div style="color: #777; font-size: 12px;">By @s.SubmittedByName on @s.DateSubmitted.ToString("dd MMM yyyy")</div>
                        @if (s.JobCardID != null)
                        {
                            <div style="margin-top: 8px;">
                                <span style="background-color: #68926D; color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600;">
                                    Job Card @s.JobCardReference
                                </span>
                            </div>
                        }
                    </div>

                    <div style="display: flex; gap: 8px; padding: 0 16px 16px;">
                        <a asp-action="Media" asp-route-id="@s.SubmissionID" target="_blank"
                               style="flex: 1; text-align: center; background-color: #68926D; color: white; text-decoration: none; padding: 8px; border-radius: 7px; font-weight: 600; font-size: 13px;">
                            View
                        </a>
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@s.SubmissionID" method="post" style="flex: 1; margin: 0;">
                                <button type="submit" onclick="return confirm('Are you sure you want to delete this submission?');"
                                        style="width: 100%; background-color: #C85A5A; color: white; border: none; padding: 8px; border-radius: 7px; font-weight: 600; font-size: 13px; cursor: pointer;">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>

                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("portfolioSearch");
        const cards = document.querySelectorAll(".portfolio-card");

        searchInput.addEventListener("input", function () {
            const value = searchInput.value.toLowerCase().trim();

            cards.forEach(function (card) {
                card.style.display = card.dataset.search.includes(value) ? "flex" : "none";
            });
        });
    </script>
}