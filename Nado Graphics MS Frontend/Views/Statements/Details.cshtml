@model Nado_Graphics_MS_Frontend.Models.StatementDetailsModel

@{
    ViewData["Title"] = "Statement Details";
    var statement = Model.Statement;
}

<div style="width: 100%; max-width: 900px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #24463A;">Statement @statement.StatementReference</h1>
        <a asp-controller="Statements" asp-action="Index"
               style="background-color: #68926D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background-color: #DCEEDC; color: #24463A; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background-color: #F8D7DA; color: #842029; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">@TempData["Error"]</div>
    }

    <div style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); padding: 30px; margin-bottom: 20px;">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
            <div>
                <div style="font-weight: 600; color: #24463A; margin-bottom: 4px;">@(statement.OrganisationID != null ? "Organisation" : "Client")</div>
                <div>@Model.AccountName</div>
                @foreach (var line in Model.AddressLines)
                {
                    <div style="color: #555;">@line</div>
                }
            </div>
            <div>
                <div style="font-weight: 600; color: #24463A; margin-bottom: 4px;">Period</div>
                <div>@statement.StartDate.ToString("dd MMM yyyy") - @statement.EndDate.ToString("dd MMM yyyy")</div>
                <div style="font-weight: 600; color: #24463A; margin: 12px 0 4px;">Generated</div>
                <div>@statement.DateGenerated.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <h3 style="color: #24463A; font-size: 18px; margin-bottom: 12px;">Transactions</h3>

        <div style="display: grid; grid-template-columns: 100px 1.2fr 2fr 1fr 1fr 1fr; gap: 10px; padding: 10px 0; border-bottom: 2px solid #68926D; font-weight: 700; color: #24463A; font-size: 14px;">
            <div>Date</div>
            <div>Reference</div>
            <div>Description</div>
            <div style="text-align: right;">Debit</div>
            <div style="text-align: right;">Credit</div>
            <div style="text-align: right;">Balance</div>
        </div>

        <div style="display: grid; grid-template-columns: 100px 1.2fr 2fr 1fr 1fr 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid #d9d9d9; font-size: 14px; font-weight: 600;">
            <div>@statement.StartDate.ToString("dd MMM yy")</div>
            <div></div>
            <div>Opening Balance</div>
            <div></div>
            <div></div>
            <div style="text-align: right;">R @Model.OpeningBalance.ToString("N2")</div>
        </div>

        @foreach (var line in Model.Lines)
        {
            <div style="display: grid; grid-template-columns: 100px 1.2fr 2fr 1fr 1fr 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid #d9d9d9; font-size: 14px;">
                <div>@line.Date.ToString("dd MMM yy")</div>
                <div>@line.Reference</div>
                <div>@line.Description</div>
                <div style="text-align: right;">@(line.Debit > 0 ? "R " + line.Debit.ToString("N2") : "")</div>
                <div style="text-align: right;">@(line.Credit > 0 ? "R " + line.Credit.ToString("N2") : "")</div>
                <div style="text-align: right;">R @line.Balance.ToString("N2")</div>
            </div>
        }

        <div style="display: flex; justify-content: flex-end; gap: 30px; margin-top: 15px; font-size: 16px; flex-wrap: wrap;">
            <div>Opening: <strong>R @Model.OpeningBalance.ToString("N2")</strong></div>
            <div>Invoiced: <strong>R @Model.TotalInvoiced.ToString("N2")</strong></div>
            <div>Paid: <strong>R @Model.TotalPaid.ToString("N2")</strong></div>
            <div>Balance Due: <strong>R @Model.ClosingBalance.ToString("N2")</strong></div>
        </div>

    </div>

    <div style="display: flex; gap: 12px; margin-bottom: 20px;">
        <a asp-controller="Statements" asp-action="DownloadPdf" asp-route-id="@statement.StatementID"
               style="background-color: #24463A; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Download PDF
        </a>
    </div>

</div>