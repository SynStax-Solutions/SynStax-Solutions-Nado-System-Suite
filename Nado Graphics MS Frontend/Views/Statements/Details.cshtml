
@model Nado_Graphics_MS_Frontend.Models.StatementDetailsModel

@{
    ViewData["Title"] = "Statement Details";
    var statement = Model.Statement;
}

<div style="width: 100%; max-width: 900px;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">

        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: var(--black, #171717) !important;">
            Statement @statement.StatementReference
        </h1>

        <a asp-controller="Statements" asp-action="Index"
           style="background-color: var(--dark-grey, #343434) !important; color: var(--white, #FFFFFF) !important; text-decoration: none !important; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background-color: var(--success, #47785B) !important; color: var(--white, #FFFFFF) !important; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="background-color: var(--danger, #B54747) !important; color: var(--white, #FFFFFF) !important; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">
            @TempData["Error"]
        </div>
    }

    <div style="background-color: var(--white, #FFFFFF) !important; color: var(--black, #171717) !important; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); padding: 30px; margin-bottom: 20px;">

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">

            <div>

                <div style="font-weight: 600; color: var(--black, #171717) !important; margin-bottom: 4px;">
                    @(statement.OrganisationID != null ? "Organisation" : "Client")
                </div>

                <div style="color: var(--black, #171717) !important;">@Model.AccountName</div>

                @foreach (var line in Model.AddressLines)
                {
                    <div style="color: var(--grey, #777777) !important;">@line</div>
                }

            </div>

            <div>

                <div style="font-weight: 600; color: var(--black, #171717) !important; margin-bottom: 4px;">
                    Period
                </div>

                <div style="color: var(--black, #171717) !important;">
                    @statement.StartDate.ToString("dd MMM yyyy") - @statement.EndDate.ToString("dd MMM yyyy")
                </div>

                <div style="font-weight: 600; color: var(--black, #171717) !important; margin: 12px 0 4px;">
                    Generated
                </div>

                <div style="color: var(--black, #171717) !important;">
                    @statement.DateGenerated.ToString("dd MMM yyyy")
                </div>

            </div>

        </div>

        <h3 style="color: var(--black, #171717) !important; font-size: 18px; margin-bottom: 12px;">
            Transactions
        </h3>

        <div style="display: grid; grid-template-columns: 100px 1.2fr 2fr 1fr 1fr 1fr; gap: 10px; padding: 10px 0; border-bottom: 2px solid var(--primary, #D4A72C) !important; font-weight: 700; color: var(--black, #171717) !important; font-size: 14px;">

            <div>Date</div>
            <div>Reference</div>
            <div>Description</div>
            <div style="text-align: right;">Debit</div>
            <div style="text-align: right;">Credit</div>
            <div style="text-align: right;">Balance</div>

        </div>

        <div style="display: grid; grid-template-columns: 100px 1.2fr 2fr 1fr 1fr 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--light-grey, #E5E5E5) !important; font-size: 14px; font-weight: 600; color: var(--black, #171717) !important;">

            <div>@statement.StartDate.ToString("dd MMM yy")</div>
            <div></div>
            <div>Opening Balance</div>
            <div></div>
            <div></div>
            <div style="text-align: right;">R @Model.OpeningBalance.ToString("N2")</div>

        </div>

        @foreach (var line in Model.Lines)
        {
            <div style="display: grid; grid-template-columns: 100px 1.2fr 2fr 1fr 1fr 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--light-grey, #E5E5E5) !important; font-size: 14px; color: var(--black, #171717) !important;">

                <div>@line.Date.ToString("dd MMM yy")</div>

                <div>@line.Reference</div>

                <div>@line.Description</div>

                <div style="text-align: right;">
                    @(line.Debit > 0 ? "R " + line.Debit.ToString("N2") : "")
                </div>

                <div style="text-align: right;">
                    @(line.Credit > 0 ? "R " + line.Credit.ToString("N2") : "")
                </div>

                <div style="text-align: right;">
                    R @line.Balance.ToString("N2")
                </div>

            </div>
        }

        <div style="display: flex; justify-content: flex-end; gap: 30px; margin-top: 15px; font-size: 16px; flex-wrap: wrap; color: var(--black, #171717) !important;">

            <div>
                Opening: <strong>R @Model.OpeningBalance.ToString("N2")</strong>
            </div>

            <div>
                Invoiced: <strong>R @Model.TotalInvoiced.ToString("N2")</strong>
            </div>

            <div>
                Paid: <strong>R @Model.TotalPaid.ToString("N2")</strong>
            </div>

            <div>
                Balance Due: <strong>R @Model.ClosingBalance.ToString("N2")</strong>
            </div>

        </div>

    </div>

    <div style="display: flex; gap: 12px; margin-bottom: 20px;">

        <a asp-controller="Statements" asp-action="DownloadPdf" asp-route-id="@statement.StatementID"
           style="background-color: var(--primary, #D4A72C) !important; color: var(--black, #171717) !important; text-decoration: none !important; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Download PDF
        </a>

    </div>

</div>
