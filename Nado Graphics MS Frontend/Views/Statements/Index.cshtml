@model List<Nado_Graphics_MS_Frontend.Models.StatementModel>

@{
    ViewData["Title"] = "Statements";
    var clients = ((List<Nado_Graphics_MS_Frontend.Models.ClientModel>)ViewBag.Clients)
        .ToDictionary(c => c.ClientID, c => $"{c.FirstName} {c.LastName}");
    var organisations = ((List<Nado_Graphics_MS_Frontend.Models.OrganisationModel>)ViewBag.Organisations)
        .ToDictionary(o => o.OrganisationID, o => o.OrganisationName);
}

<div style="width: 100%;">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <h1 style="margin: 0; font-size: 32px; font-weight: 700; color: #24463A;">Statements</h1>
        <a asp-controller="Owner" asp-action="Dashboard"
               style="background-color: #68926D; color: white; text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
            Back
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background-color: #DCEEDC; color: #24463A; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background-color: #F8D7DA; color: #842029; padding: 12px 16px; border-radius: 7px; margin-bottom: 20px;">@TempData["Error"]</div>
    }

    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 25px;">
        <div style="flex: 1;">
            <input type="text" id="statementSearch" placeholder="Search by reference or client / organisation..."
                   style="width: 100%; height: 44px; padding: 8px 15px; border: 1px solid #aaa; border-radius: 7px; font-size: 15px; outline: none;" />
        </div>
        <a asp-controller="Statements" asp-action="Create"
               style="height: 44px; display: flex; align-items: center; gap: 7px; background-color: #5A93C8; color: white; text-decoration: none; padding: 0 20px; border-radius: 7px; font-weight: 600; white-space: nowrap;">
            Create Statement
        </a>
    </div>

    <div style="background-color: white; border-radius: 14px; box-shadow: 0 5px 14px rgba(0,0,0,0.16); overflow: hidden;">

        <div style="display: grid; grid-template-columns: 90px 1.4fr 1.6fr 1.6fr 1fr 140px; align-items: center; padding: 16px 20px; background-color: #68926D; color: white; font-weight: 700; font-size: 14px;">
            <div>ID</div>
            <div>Reference</div>
            <div>Account</div>
            <div>Period</div>
            <div>Generated</div>
            <div style="text-align: center;">Manage</div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div style="padding: 55px 20px; text-align: center; color: #666;">
                <h3 style="margin-top: 12px; color: #24463A;">No Statements Found</h3>
                <p style="margin-bottom: 0;">There are currently no statements on record.</p>
            </div>
        }
        else
        {
            foreach (var statement in Model)
            {
                var isOrganisation = statement.OrganisationID != null;

                var accountName = isOrganisation
                    ? (organisations.TryGetValue(statement.OrganisationID!.Value, out var orgName) ? orgName : "Unknown Organisation")
                    : (clients.TryGetValue(statement.ClientID ?? 0, out var clientName) ? clientName : "Unknown Client");

                <div class="statement-row"
                     data-reference="@statement.StatementReference"
                     data-account="@accountName"
                     style="display: grid; grid-template-columns: 90px 1.4fr 1.6fr 1.6fr 1fr 140px; align-items: center; padding: 16px 20px; border-bottom: 1px solid #d9d9d9; font-size: 14px;">

                    <div>@statement.StatementID</div>
                    <div style="font-weight: 600; color: #24463A;">@statement.StatementReference</div>
                    <div>
                        @accountName
                        @if (isOrganisation)
                        {
                            <span style="background-color: #5A93C8; color: white; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; margin-left: 6px;">Organisation</span>
                        }
                    </div>
                    <div>@statement.StartDate.ToString("dd MMM yyyy") - @statement.EndDate.ToString("dd MMM yyyy")</div>
                    <div>@statement.DateGenerated.ToString("dd MMM yyyy")</div>

                    <div style="display: flex; justify-content: center; align-items: center;">
                        <div class="dropdown">
                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    style="background-color: #68926D; color: white; border: none; border-radius: 7px; box-shadow: 0 3px 6px rgba(0, 0, 0, 0.20);">
                                Manage
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Statements" asp-action="DownloadPdf" asp-route-id="@statement.StatementID">
                                        Download PDF
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Statements" asp-action="Details" asp-route-id="@statement.StatementID">
                                        View
                                    </a>
                                </li>
                                <li>
                                    <form asp-controller="Statements" asp-action="Delete" asp-route-id="@statement.StatementID" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item"
                                                onclick="return confirm('Are you sure you want to delete this statement?');">
                                            Delete
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            }
        }

    </div>

</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("statementSearch");
        const statementRows = document.querySelectorAll(".statement-row");

        searchInput.addEventListener("input", function () {
            const value = searchInput.value.toLowerCase().trim();

            statementRows.forEach(function (row) {
                const matches = row.dataset.reference.toLowerCase().includes(value)
                             || row.dataset.account.toLowerCase().includes(value);

                row.style.display = matches ? "grid" : "none";
            });
        });
    </script>
}