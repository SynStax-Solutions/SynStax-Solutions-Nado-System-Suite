
@{
    ViewData["Title"] = "Designer Dashboard";
    
}

<div style="padding: 35px 45px; max-width: 1400px; margin: 0 auto;">

    <div style="text-align: center; margin-bottom: 35px;">
        <h1 style="margin: 0; color: var(--black, #171717); font-size: 32px; font-weight: 700;">
            Designer Dashboard
        </h1>
        <div style="width: 80px; height: 3px; background-color: var(--primary, #D4A72C); margin: 12px auto 0;"></div>
        <p style="color: var(--grey, #777777); margin: 15px 0 0;">Welcome, @User.Identity?.Name.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;">

        <div style="background-color: var(--white, #FFFFFF); border: 2px solid var(--black, #171717); border-radius: 14px; padding: 25px; box-shadow: 0 6px 14px rgba(0,0,0,0.15);">
            <h2 style="margin: 0 0 8px 0; color: var(--black, #171717); font-size: 22px;">Job Cards</h2>
            <p style="color: var(--grey, #777777);">View the jobs assigned to you.</p>
            <a asp-controller="JobCards" asp-action="Index"
                   style="display: inline-block; background-color: var(--primary, #D4A72C); color: var(--black, #171717); text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
                View Job Cards
            </a>
        </div>

        <div style="background-color: var(--white, #FFFFFF); border: 2px solid var(--black, #171717); border-radius: 14px; padding: 25px; box-shadow: 0 6px 14px rgba(0,0,0,0.15);">
            <h2 style="margin: 0 0 8px 0; color: var(--black, #171717); font-size: 22px;">Portfolio</h2>
            <p style="color: var(--grey, #777777);">Submit finished work for the portfolio.</p>
            <a asp-controller="Portfolio" asp-action="Index"
                   style="display: inline-block; background-color: var(--primary, #D4A72C); color: var(--black, #171717); text-decoration: none; padding: 10px 20px; border-radius: 7px; font-weight: 600;">
                Open Portfolio
            </a>
        </div>

    </div>
</div>
