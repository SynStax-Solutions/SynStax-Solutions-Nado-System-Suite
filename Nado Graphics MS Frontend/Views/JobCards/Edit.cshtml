@model Nado_Graphics_MS_Frontend.Models.JobCardModel

@{
    ViewData["Title"] = "Edit Job Card";
}

<div style="width: 100%;">

    <!-- PAGE HEADING -->
    <div style="margin-bottom: 25px;">

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: var(--black, #171717) !important;">
            Edit Job Card
        </h1>

        <p style="
            margin: 5px 0 0 0;
            color: var(--grey, #777777) !important;
            font-size: 15px;">
            Update the details of @Model.ReferenceNumber.
        </p>

    </div>

    <!-- EDIT JOB CARD FORM -->
    <div style="
        background: var(--white, #FFFFFF) !important;
        background-color: var(--white, #FFFFFF) !important;
        color: var(--black, #171717) !important;
        border: 2px solid var(--black, #171717) !important;
        border-radius: 14px;
        box-shadow: 0 6px 14px rgba(0,0,0,0.20);
        padding: 25px;
        max-width: 800px;">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <!-- HIDDEN MODEL VALUES -->
            <input type="hidden" asp-for="JobCardID" />
            <input type="hidden" asp-for="ReferenceNumber" />
            <input type="hidden" asp-for="ClientID" />
            <input type="hidden" asp-for="JobDate" />
            <input type="hidden" asp-for="PortfolioSubmissionID" />

            <!-- VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly"
                 style="
                    color: var(--danger, #B54747) !important;
                    margin-bottom: 15px;">
            </div>

            <!-- JOB TITLE -->
            <div style="margin-bottom: 20px;">

                <label asp-for="JobTitle"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;
                            color: var(--black, #171717) !important;">
                    Job Title
                </label>

                <input asp-for="JobTitle"
                       class="form-control"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 2px solid var(--black, #171717) !important;
                            border-radius: 7px;
                            padding: 10px;" />

                <span asp-validation-for="JobTitle"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- JOB DESCRIPTION -->
            <div style="margin-bottom: 20px;">

                <label asp-for="JobDescription"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;
                            color: var(--black, #171717) !important;">
                    Job Description
                </label>

                <textarea asp-for="JobDescription"
                          class="form-control"
                          rows="5"
                          style="
                                background-color: var(--white, #FFFFFF) !important;
                                color: var(--black, #171717) !important;
                                border: 2px solid var(--black, #171717) !important;
                                border-radius: 7px;
                                padding: 10px;"></textarea>

                <span asp-validation-for="JobDescription"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- JOB STATUS -->
            <div style="margin-bottom: 20px;">

                <label asp-for="JobStatus"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;
                            color: var(--black, #171717) !important;">
                    Job Status
                </label>

                <select asp-for="JobStatus"
                        class="form-select"
                        style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 2px solid var(--black, #171717) !important;
                            border-radius: 7px;
                            padding: 10px;">

                    <option value="Not Started">Not Started</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Archived">Archived</option>

                </select>

                <span asp-validation-for="JobStatus"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- DUE DATE -->
            <div style="margin-bottom: 20px;">

                <label asp-for="DueDate"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;
                            color: var(--black, #171717) !important;">
                    Due Date
                </label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 2px solid var(--black, #171717) !important;
                            border-radius: 7px;
                            padding: 10px;" />

                <span asp-validation-for="DueDate"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- COMPLETED AT -->
            <div style="margin-bottom: 25px;">

                <label asp-for="CompletedAt"
                       style="
                            display: block;
                            font-weight: 600;
                            margin-bottom: 7px;
                            color: var(--black, #171717) !important;">
                    Completed At
                </label>

                <input asp-for="CompletedAt"
                       type="datetime-local"
                       class="form-control"
                       style="
                            background-color: var(--white, #FFFFFF) !important;
                            color: var(--black, #171717) !important;
                            border: 2px solid var(--black, #171717) !important;
                            border-radius: 7px;
                            padding: 10px;" />

                <span asp-validation-for="CompletedAt"
                      style="color: var(--danger, #B54747) !important;">
                </span>

            </div>

            <!-- FORM ACTION BUTTONS -->
            <div style="
                display: flex;
                justify-content: flex-end;
                gap: 12px;">

                <!-- DARK GREY CANCEL BUTTON -->
                <a asp-action="Details"
                   asp-route-id="@Model.JobCardID"
                   style="
                        background: var(--dark-grey, #343434) !important;
                        background-color: var(--dark-grey, #343434) !important;
                        color: var(--white, #FFFFFF) !important;
                        text-decoration: none !important;
                        padding: 11px 22px;
                        border-radius: 7px;
                        font-weight: 600;">
                    Cancel
                </a>

                <!-- MUSTARD SAVE BUTTON -->
                <button type="submit"
                        style="
                            background: var(--primary, #D4A72C) !important;
                            background-color: var(--primary, #D4A72C) !important;
                            color: var(--black, #171717) !important;
                            border: none !important;
                            padding: 11px 22px;
                            border-radius: 7px;
                            font-weight: 600;">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


