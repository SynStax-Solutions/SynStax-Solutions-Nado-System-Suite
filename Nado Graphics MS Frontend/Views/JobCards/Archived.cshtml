
@model List<Nado_Graphics_MS_Frontend.Models.JobCardModel>

@{
    ViewData["Title"] = "Archived Job Cards";
}

<div style="padding: 30px;">

    <!-- PAGE HEADING AND BACK BUTTON -->
    <div style="
        display: flex;
        justify-content: space-between;
        align-items: center;">

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: var(--black, #171717) !important;">
            Archived Job Cards
        </h1>

        <!-- DARK GREY BACK BUTTON -->
        <a asp-action="Index"
           style="
                background: var(--dark-grey, #343434) !important;
                background-color: var(--dark-grey, #343434) !important;
                color: var(--white, #FFFFFF) !important;
                padding: 10px 18px;
                border-radius: 8px;
                text-decoration: none !important;
                font-weight: 600;
                border: none;">
            Back to Job Cards
        </a>

    </div>

    <!-- MUSTARD DIVIDER -->
    <div style="
        height: 3px;
        background: var(--primary, #D4A72C) !important;
        background-color: var(--primary, #D4A72C) !important;
        margin: 20px 0;">
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- EMPTY STATE -->
        <div style="
            padding: 25px;
            background: var(--white, #FFFFFF) !important;
            background-color: var(--white, #FFFFFF) !important;
            color: var(--black, #171717) !important;
            border-radius: 10px;
            box-shadow: 0 5px 14px rgba(0,0,0,0.12);">

            There are no archived Job Cards.

        </div>
    }
    else
    {
        <!-- ARCHIVED JOB CARDS GRID -->
        <div style="
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;">

            @foreach (var job in Model)
            {
                <!-- ARCHIVED CARD -->
                <div style="
                    padding: 20px;
                    background: #777777 !important;
                    background-color: #777777 !important;
                    border-radius: 12px;
                    box-shadow: 0 3px 8px rgba(0,0,0,0.12);
                    color: #FFFFFF !important;">

                    <!-- JOB TITLE -->
                    <h3 style="
                        color: #FFFFFF !important;">
                        @job.JobTitle
                    </h3>

                    <!-- REFERENCE -->
                    <p style="color: #FFFFFF !important;">

                        <strong style="color: #FFFFFF !important;">
                            Reference:
                        </strong>

                        @job.ReferenceNumber

                    </p>

                    <!-- STATUS -->
                    <p style="color: #FFFFFF !important;">

                        <strong style="color: #FFFFFF !important;">
                            Status:
                        </strong>

                        Archived

                    </p>

                    <!-- JOB DATE -->
                    <p style="color: #FFFFFF !important;">

                        <strong style="color: #FFFFFF !important;">
                            Job Date:
                        </strong>

                        @job.JobDate.ToString("dd/MM/yyyy")

                    </p>

                    <!-- COMPLETED DATE -->
                    @if (job.CompletedAt.HasValue)
                    {
                        <p style="color: #FFFFFF !important;">

                            <strong style="color: #FFFFFF !important;">
                                Completed:
                            </strong>

                            @job.CompletedAt.Value.ToString("dd/MM/yyyy")

                        </p>
                    }

                    <!-- VIEW JOB BUTTON -->
                    <a asp-action="Details"
                       asp-route-id="@job.JobCardID"
                       style="
                            display: inline-block;
                            margin-top: 10px;
                            padding: 8px 14px;
                            background: rgba(255,255,255,0.2) !important;
                            background-color: rgba(255,255,255,0.2) !important;
                            color: #FFFFFF !important;
                            border: 1px solid #FFFFFF !important;
                            border-radius: 6px;
                            text-decoration: none !important;
                            font-weight: 600;">
                        View Job
                    </a>

                </div>
            }

        </div>
    }

</div>


