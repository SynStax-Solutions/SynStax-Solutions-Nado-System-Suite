
@model List<Nado_Graphics_MS_Frontend.Models.JobCardModel>

@{
    ViewData["Title"] = "Job Cards";
}

<div style="padding: 30px;">

    <!-- PAGE HEADING AND ARCHIVED BUTTON -->
    <div style="
        display: flex;
        justify-content: space-between;
        align-items: center;">

        <h1 style="
            margin: 0;
            font-size: 32px;
            font-weight: 700;
            color: var(--black, #171717) !important;">
            Job Cards
        </h1>

        <a asp-action="Archived"
           style="
                background: var(--dark-grey, #343434) !important;
                background-color: var(--dark-grey, #343434) !important;
                color: var(--white, #FFFFFF) !important;
                padding: 10px 18px;
                border-radius: 8px;
                text-decoration: none !important;
                font-weight: 600;
                border: none;">
            Archived Job Cards
        </a>

    </div>

    <!-- MUSTARD DIVIDER -->
    <div style="
        height: 3px;
        background: var(--primary, #D4A72C) !important;
        background-color: var(--primary, #D4A72C) !important;
        margin: 20px 0;">
    </div>

    <!-- SEARCH AND STATUS FILTER -->
    <div style="
        display: flex;
        gap: 10px;
        margin-bottom: 25px;">

        <input type="text"
               id="searchInput"
               placeholder="Search jobs..."
               style="
                    padding: 10px;
                    border: 1px solid var(--light-grey, #E5E5E5);
                    border-radius: 8px;
                    background-color: var(--white, #FFFFFF);
                    color: var(--black, #171717);
                    font-size: 15px;" />

        <select id="statusFilter"
                style="
                    padding: 10px;
                    border: 1px solid var(--light-grey, #E5E5E5);
                    border-radius: 8px;
                    background-color: var(--white, #FFFFFF);
                    color: var(--black, #171717);
                    font-size: 15px;">

            <option value="">
                All Statuses
            </option>

            <option value="Not Started">
                Not Started
            </option>

            <option value="In Progress">
                In Progress
            </option>

            <option value="Completed">
                Completed
            </option>

            <option value="Archived">
                Archived
            </option>

        </select>

    </div>

    <!-- ALL JOBS HEADING -->
    <h2 style="
        color: var(--black, #171717) !important;
        font-weight: 700;">
        ALL JOBS
    </h2>

    @if (Model == null || !Model.Any())
    {
        <!-- EMPTY STATE -->
        <div style="
            padding: 25px;
            background: var(--white, #FFFFFF) !important;
            background-color: var(--white, #FFFFFF) !important;
            color: var(--black, #171717) !important;
            border-radius: 10px;
            box-shadow: 0 5px 14px rgba(0,0,0,0.12);">

            Accept a quote to automatically create a Job Card.

        </div>
    }
    else
    {
        <!-- JOB CARDS GRID -->
        <div id="jobGrid"
             style="
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;">

            @foreach (var job in Model)
            {
                @* Keep the original job status colours. *@
                var cardBackground = job.JobStatus switch
                {
                    "In Progress" => "#DFA738",
                    "Completed" => "#68926D",
                    "Archived" => "#777777",
                    _ => "#D46271"
                };

                <div class="job-card"
                     data-title="@job.JobTitle"
                     data-reference="@job.ReferenceNumber"
                     data-status="@job.JobStatus"
                     style="
                        padding: 20px;
                        border-radius: 12px;
                        border: 2px solid transparent;
                        box-shadow: 0 3px 8px rgba(0,0,0,0.12);
                        color: #FFFFFF !important;
                        background: @cardBackground !important;
                        background-color: @cardBackground !important;">

                    <!-- JOB TITLE -->
                    <h3 style="color: #FFFFFF !important;">
                        @job.JobTitle
                    </h3>

                    <!-- REFERENCE -->
                    <p style="color: #FFFFFF !important;">

                        <strong style="color: #FFFFFF !important;">
                            Reference:
                        </strong>

                        @job.ReferenceNumber

                    </p>

                    <!-- STATUS -->
                    <p style="color: #FFFFFF !important;">

                        <strong style="color: #FFFFFF !important;">
                            Status:
                        </strong>

                        @job.JobStatus

                    </p>

                    <!-- JOB DATE -->
                    <p style="color: #FFFFFF !important;">

                        <strong style="color: #FFFFFF !important;">
                            Job Date:
                        </strong>

                        @job.JobDate.ToString("dd/MM/yyyy")

                    </p>

                    <!-- DUE DATE -->
                    @if (job.DueDate.HasValue)
                    {
                        <p style="color: #FFFFFF !important;">

                            <strong style="color: #FFFFFF !important;">
                                Due Date:
                            </strong>

                            @job.DueDate.Value.ToString("dd/MM/yyyy")

                        </p>
                    }

                    <!-- VIEW JOB BUTTON -->
                    <a asp-action="Details"
                       asp-route-id="@job.JobCardID"
                       style="
                            display: inline-block;
                            margin-top: 10px;
                            padding: 8px 14px;
                            background: rgba(255,255,255,0.2) !important;
                            background-color: rgba(255,255,255,0.2) !important;
                            color: #FFFFFF !important;
                            border: 1px solid #FFFFFF !important;
                            border-radius: 6px;
                            text-decoration: none !important;
                            font-weight: 600;">
                        View Job
                    </a>

                </div>
            }

        </div>
    }

</div>

<script>

    const searchInput = document.getElementById("searchInput");

    const statusFilter = document.getElementById("statusFilter");

    function filterJobs() {

        const search = searchInput.value.toLowerCase();

        const status = statusFilter.value;

        document.querySelectorAll(".job-card").forEach(card => {

            const title = card.dataset.title.toLowerCase();

            const reference = card.dataset.reference.toLowerCase();

            const cardStatus = card.dataset.status;

            const matchesSearch =
                title.includes(search) ||
                reference.includes(search);

            const matchesStatus =
                status === "" ||
                cardStatus === status;

            card.style.display =
                matchesSearch && matchesStatus ? "block" : "none";

        });

    }

    searchInput.addEventListener("input", filterJobs);

    statusFilter.addEventListener("change", filterJobs);

</script>

