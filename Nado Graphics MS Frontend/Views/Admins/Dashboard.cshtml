@{
    ViewData["Title"] = "Admin Dashboard";
    var enquiries = (ViewBag.Enquiries as List<Nado_Graphics_MS_Frontend.Models.EnquiryModel>) ?? new();
        
}

@* This is the PA/Admin dashboard. Graphic Designers can't open it. *@
<div class="container mt-5">

    <h1>Admin Dashboard</h1>
    <p class="text-muted">Welcome, @User.Identity?.Name.</p>

    <div class="row mt-4 g-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">User Management</h5>
                    @* A PA/Admin can only create and manage Graphic Designers. *@
                    <p class="card-text">Create and manage Graphic Designer accounts.</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Clients</h5>
                    <p class="card-text">View and manage clients.</p>
                    <a asp-controller="Clients" asp-action="Index" class="btn btn-primary">Clients</a>
                </div>
            </div>
        </div>
       
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        Enquiries
                        @if (enquiries.Any(e => !e.IsRead))
                        {
                            <span class="badge bg-danger">@enquiries.Count(e => !e.IsRead) new</span>
                        }
                    </h5>
                    <p class="card-text">View enquiries from the website.</p>
                    <a asp-controller="Enquiries" asp-action="Index" class="btn btn-primary">Enquiries</a>
                </div>
            </div>
        </div>
    </div>

</div>