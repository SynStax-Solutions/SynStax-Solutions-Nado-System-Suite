@{
    ViewData["Title"] = "Admin Dashboard";
}

@* This is the PA/Admin dashboard. Graphic Designers can't open it. *@
<div class="container mt-5">

    <h1>Admin Dashboard</h1>
    <p class="text-muted">Welcome, @User.Identity?.Name.</p>

    <div class="row mt-4 g-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">User Management</h5>
                    @* A PA/Admin can only create and manage Graphic Designers. *@
                    <p class="card-text">Create and manage Graphic Designer accounts.</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Manage Users</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Clients</h5>
                    <p class="card-text">View and manage clients.</p>
                    <a asp-controller="Clients" asp-action="Index" class="btn btn-primary">Clients</a>
                </div>
            </div>
        </div>
    </div>

</div>