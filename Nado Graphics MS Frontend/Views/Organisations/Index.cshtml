@model List<Nado_Graphics_MS_Frontend.Models.OrganisationModel>

@{
    ViewData["Title"] = "Organisations";
}

<div class="container-fluid">

    <div style="
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px; ">

        <div>

            <h1 style="
                color: #24463A;
                font-weight: 600;
                margin-bottom: 5px; ">
                Organisations
            </h1>

            <p style="
                color: #6c757d;
                margin-bottom: 0; ">
                Manage and view all organisations.
            </p>

        </div>

        <a asp-action="Create"
           class="btn"
           style="
               background-color: #68926D;
               color: white;
               border: none;
               border-radius: 7px;
               padding: 10px 18px;
               box-shadow: 0 4px 8px rgba(0, 0, 0, 0.20); ">
            New Organisation
        </a>

    </div>

    <div style="
        background-color: white;
        border: 2px solid black;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.30);">

        <table class="table table-striped table-hover"
               style="
                   margin-bottom: 0;
                   background-color: white; ">

            <thead>

                <tr>

                    <th style="
                        background-color: #68926D;
                        color: white;
                        padding: 14px;">
                        Organisation
                    </th>

                    <th style="
                        background-color: #68926D;
                        color: white;
                        padding: 14px;">
                        Registration Number
                    </th>

                    <th style="
                        background-color: #68926D;
                        color: white;
                        padding: 14px;">
                        Email
                    </th>

                    <th style="
                        background-color: #68926D;
                        color: white;
                        padding: 14px;">
                        Phone
                    </th>

                    <th style="
                        background-color: #68926D;
                        color: white;
                        padding: 14px;">
                        Manage
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var organisation in Model)
                    {
                        <tr>

                            <td style="padding: 14px;">
                                <strong>
                                    @organisation.OrganisationName
                                </strong>
                            </td>

                            <td style="padding: 14px;">
                                @(string.IsNullOrEmpty(organisation.RegistrationNumber) ? "—": organisation.RegistrationNumber)
                            </td>

                            <td style="padding: 14px;">
                                @(string.IsNullOrEmpty(organisation.Email) ? "—" : organisation.Email)
                            </td>

                            <td style="padding: 14px;">
                                @(string.IsNullOrEmpty(organisation.Phone)  ? "—"  : organisation.Phone)
                            </td>

                            <td style="padding: 14px;">

                                <div class="dropdown">

                                    <button class="btn dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            style="
                                                background-color: #68926D;
                                                color: white;
                                                border: none;
                                                border-radius: 7px;
                                                box-shadow: 0 3px 6px rgba(0, 0, 0, 0.20); ">
                                        Manage
                                    </button>

                                    <ul class="dropdown-menu">

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@organisation.OrganisationID">
                                                View
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@organisation.OrganisationID">
                                                Edit
                                            </a>
                                        </li>

                                        <li>
                                            <form asp-action="Delete"
                                                  asp-route-id="@organisation.OrganisationID"
                                                  method="post">

                                                <button type="submit"
                                                        class="dropdown-item"
                                                        onclick="return confirm('Are you sure you want to delete this organisation?');">
                                                    Delete
                                                </button>

                                            </form>
                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            style="
                                padding: 40px;
                                text-align: center;
                                color: #6c757d; ">

                            No organisations have been added yet.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>